# Function to run caddie-specific linting with limit
function caddie_core_lint_limit() {
    local limit="$1"
    local target="$2"
    
    if [ -z "$limit" ] || [ -z "$target" ]; then
        caddie cli:red "Error: Both limit and target are required"
        caddie cli:usage "caddie core:lint:limit <limit> <target>"
        caddie cli:indent "Example: caddie core:lint:limit 5 modules/dot_caddie_ruby"
        return 1
    fi
    
    # Validate limit is a number
    if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
        caddie cli:red "Error: Limit must be a positive number"
        return 1
    fi
    
    caddie_core_lint "$target" "$limit"
    return $?
}

function caddie_core_module_commands() {
    local module="$1"
    local commands_fn=""
    local output=""
    local cmd=""

    if [ -z "$module" ]; then
        caddie cli:red "Error: module name required"
        caddie cli:usage "caddie core:module:commands <module>"
        caddie cli:thought "Example: caddie core:module:commands js"
        return 1
    fi

    commands_fn="caddie_${module}_commands"
    if declare -F "$commands_fn" >/dev/null 2>&1; then
        output="$($commands_fn)"
    else
        caddie cli:red "Error: No command list for module '${module}'"
        caddie cli:thought "Try: caddie ${module}:help"
        return 1
    fi

    if [ -z "$output" ]; then
        caddie cli:yellow "No commands registered for module '${module}'"
        return 1
    fi

    for cmd in $output; do
        printf '%s\n' "$cmd"
    done
    return 0
}

# Reload one installed module (or all modules) without re-sourcing the full bash profile.
# Use after make install of a plugin (e.g. csv) while staying in the REPL.
function caddie_core_module_reload() {
    local module="${1:-}"
    local modules_dir="${CADDIE_MODULES_DIR:-$HOME/.caddie_modules}"
    local module_file=""
    local commands_fn=""
    local completion_output=""
    local prompt_fn=""

    if [ ! -d "$modules_dir" ]; then
        caddie cli:red "Error: Modules directory not found: ${modules_dir}"
        return 1
    fi

    # No module name → refresh every installed module in-place
    if [ -z "$module" ]; then
        caddie cli:title "Reloading all caddie modules"
        unset CADDIE_CLI_LOADED
        if ! declare -F _caddie_load_modules >/dev/null 2>&1; then
            caddie cli:red "Error: Module loader unavailable; run 'caddie reload' instead"
            return 1
        fi
        if ! _caddie_load_modules; then
            caddie cli:red "Failed to reload modules"
            return 1
        fi
        if [[ $- == *i* ]] && command -v complete >/dev/null 2>&1; then
            complete -F _caddie_completion -o default -o nospace caddie
        fi
        caddie cli:check "All modules reloaded"
        caddie cli:thought "Session env defaults (e.g. CADDIE_CSV_FILE) are preserved"
        return 0
    fi

    module_file="${modules_dir}/.caddie_${module}"
    if [ ! -f "$module_file" ]; then
        caddie cli:red "Error: Module '${module}' not found at ${module_file}"
        caddie cli:thought "Install the module, then try again (example: cd plugin-repo && make install)"
        caddie cli:usage "caddie core:module:reload [module]"
        return 1
    fi

    caddie cli:title "Reloading module: ${module}"

    # CLI helpers are idempotent via CADDIE_CLI_LOADED; clear so a cli/core reload refreshes them
    if [ "$module" = "cli" ] || [ "$module" = "core" ]; then
        unset CADDIE_CLI_LOADED
    fi

    # shellcheck disable=SC1090
    if ! source "$module_file"; then
        caddie cli:red "Failed to source ${module_file}"
        return 1
    fi

    caddie_modules_append "$module"

    commands_fn="caddie_${module}_commands"
    if declare -F "$commands_fn" >/dev/null 2>&1; then
        completion_output="$($commands_fn)"
        if [ -n "$completion_output" ]; then
            caddie_completion_register "$module" "$completion_output"
        fi
    fi

    prompt_fn="caddie_${module}_prompt_segment"
    if declare -F "$prompt_fn" >/dev/null 2>&1; then
        caddie_prompt_register_segment "$prompt_fn"
    fi

    caddie cli:check "Module '${module}' reloaded from ${module_file}"
    caddie cli:thought "In a module-scoped prompt, 'reload' runs this for the active module"
    return 0
}

function caddie_core_agent_exec() {
    local agent_exec=""
    local status=0

    if [ "$#" -eq 0 ]; then
        caddie cli:red "Error: provide a caddie command"
        caddie cli:usage "caddie agent:exec <module:command> [args...]"
        caddie cli:usage "caddie core:agent:exec <module:command> [args...]"
        caddie cli:thought "Example: caddie agent:exec js:project:test"
        return 1
    fi

    agent_exec="${HOME}/.caddie_modules/bin/caddie-agent-exec"
    if [ ! -x "$agent_exec" ]; then
        caddie cli:red "Error: caddie agent bootstrap not found (run make install)"
        return 1
    fi

    "$agent_exec" "$@"
    status=$?
    return "$status"
}

function caddie_agent_exec() {
    caddie_core_agent_exec "$@"
    return $?
}

