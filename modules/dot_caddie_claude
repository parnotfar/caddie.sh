function caddie_claude_init() {
    local target_dir="${1:-.}"
    local claude_dir=""
    local commands_dir=""
    local claude_md=""
    local review_command_md=""

    if [ ! -d "$target_dir" ]; then
        caddie cli:red "Error: Directory does not exist: $target_dir"
        caddie cli:usage "caddie claude:init [dir]"
        return 1
    fi

    claude_dir="${target_dir}/.claude"
    commands_dir="${claude_dir}/commands"
    claude_md="${target_dir}/CLAUDE.md"
    review_command_md="${commands_dir}/review.md"

    mkdir -p "$commands_dir"
    if [ ! -d "$commands_dir" ]; then
        caddie cli:red "Error: Unable to create Claude directory structure"
        return 1
    fi

    if [ ! -f "$claude_md" ]; then
        cat > "$claude_md" <<'EOF_CLAUDE_MD'
# CLAUDE.md

## Project Context
Describe the product, architecture, and the most important goals.

## Development Rules
List coding standards, test requirements, and review expectations.

## Commands
- Build: <command>
- Test: <command>
- Lint: <command>

## Definition of Done
Document what must pass before merging changes.
EOF_CLAUDE_MD
        caddie cli:check "Created: $claude_md"
    else
        caddie cli:indent "Already exists: $claude_md"
    fi

    if [ ! -f "$review_command_md" ]; then
        cat > "$review_command_md" <<'EOF_REVIEW_MD'
Review the current branch for bugs and regressions.
Prioritize high-severity findings.
Call out missing tests and concrete follow-up actions.
EOF_REVIEW_MD
        caddie cli:check "Created: $review_command_md"
    else
        caddie cli:indent "Already exists: $review_command_md"
    fi

    caddie cli:check "Claude Code project scaffold is ready"
    caddie cli:thought "Next: run 'caddie claude:auth:login' and then 'caddie claude:run'"
    return 0
}

function caddie_claude_help() {
    caddie cli:title "Claude Code Commands"
    caddie cli:usage "caddie claude:<command>"
    caddie cli:blank
    caddie cli:indent "info                              Show Claude CLI and config status"
    caddie cli:indent "init [dir]                        Create CLAUDE.md and .claude/commands scaffold"
    caddie cli:indent "run [prompt]                      Start Claude (or run one prompt)"
    caddie cli:indent "print <prompt> [opts...]          Run non-interactive prompt mode"
    caddie cli:indent "continue                          Continue the most recent session"
    caddie cli:indent "resume [session-id]               Resume a specific prior session"
    caddie cli:indent "auth:login                        Log in to Claude Code"
    caddie cli:indent "auth:logout                       Log out from Claude Code"
    caddie cli:indent "doctor                            Run Claude diagnostics"
    caddie cli:indent "update                            Update Claude Code"
    caddie cli:indent "mcp [args...]                     Forward args to 'claude mcp'"
    caddie cli:indent "agents [args...]                  Forward args to 'claude agents'"
    caddie cli:blank
    caddie cli:title "Defaults"
    caddie cli:indent "model:set|get|unset               Configure default --model"
    caddie cli:indent "permission:mode:set|get|unset     Configure default --permission-mode"
    caddie cli:blank
    caddie cli:title "Examples"
    caddie cli:indent "caddie claude:init ."
    caddie cli:indent "caddie claude:auth:login"
    caddie cli:indent "caddie claude:run"
    caddie cli:indent "caddie claude:print 'Summarize this repo' --output-format text"
    caddie cli:indent "caddie claude:model:set claude-opus-4-1"
    caddie cli:indent "caddie claude:permission:mode:set acceptEdits"
    return 0
}

