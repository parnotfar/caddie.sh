#!/usr/bin/env bash

# Caddie.sh - Claude Code Module
# This file provides Claude Code onboarding and CLI helpers

source "$HOME/.caddie_modules/.caddie_cli"

function caddie_claude_require_cli() {
    if command -v claude >/dev/null 2>&1; then
        return 0
    fi

    caddie cli:red "Error: Claude Code CLI is not installed"
    caddie cli:thought "Install with: npm install -g @anthropic-ai/claude-code"
    return 1
}

function caddie_claude_model_set() {
    local value="$1"
    if [ -z "$value" ]; then
        caddie cli:red "Error: Please provide a model"
        caddie cli:usage "caddie claude:model:set <model>"
        return 1
    fi

    export CADDIE_CLAUDE_MODEL="$value"
    caddie cli:check "Claude model set to: $value"
    return 0
}

function caddie_claude_model_get() {
    local value="${CADDIE_CLAUDE_MODEL:-}"
    if [ -n "$value" ]; then
        caddie cli:green "Claude model: $value"
    else
        caddie cli:yellow "No Claude model is set"
        caddie cli:thought "Use 'caddie claude:model:set <model>' to set one"
    fi
    return 0
}

function caddie_claude_model_unset() {
    if [ -n "${CADDIE_CLAUDE_MODEL:-}" ]; then
        unset CADDIE_CLAUDE_MODEL
        caddie cli:check "Claude model unset"
    else
        caddie cli:yellow "No Claude model was set"
    fi
    return 0
}

function caddie_claude_permission_mode_set() {
    local value="$1"
    if [ -z "$value" ]; then
        caddie cli:red "Error: Please provide a permission mode"
        caddie cli:usage "caddie claude:permission:mode:set <default|acceptEdits|bypassPermissions|plan>"
        return 1
    fi

    case "$value" in
      default|acceptEdits|bypassPermissions|plan)
        ;;
      *)
        caddie cli:red "Error: Invalid permission mode: $value"
        caddie cli:thought "Allowed: default, acceptEdits, bypassPermissions, plan"
        return 1
        ;;
    esac

    export CADDIE_CLAUDE_PERMISSION_MODE="$value"
    caddie cli:check "Claude permission mode set to: $value"
    return 0
}

function caddie_claude_permission_mode_get() {
    local value="${CADDIE_CLAUDE_PERMISSION_MODE:-}"
    if [ -n "$value" ]; then
        caddie cli:green "Claude permission mode: $value"
    else
        caddie cli:yellow "No Claude permission mode is set"
        caddie cli:thought "Use 'caddie claude:permission:mode:set <mode>' to set one"
    fi
    return 0
}

function caddie_claude_permission_mode_unset() {
    if [ -n "${CADDIE_CLAUDE_PERMISSION_MODE:-}" ]; then
        unset CADDIE_CLAUDE_PERMISSION_MODE
        caddie cli:check "Claude permission mode unset"
    else
        caddie cli:yellow "No Claude permission mode was set"
    fi
    return 0
}

function caddie_claude_info() {
    local cli_path=""
    local cli_version=""

    caddie cli:title "Claude Code Info"

    if command -v claude >/dev/null 2>&1; then
        cli_path="$(command -v claude)"
        caddie cli:indent "cli: $cli_path"
        cli_version="$(claude --version 2>/dev/null | head -n1)"
        if [ -n "$cli_version" ]; then
            caddie cli:indent "version: $cli_version"
        fi
    else
        caddie cli:indent "cli: not found"
    fi

    if [ -d "$HOME/.claude" ]; then
        caddie cli:indent "global config: $HOME/.claude"
    else
        caddie cli:indent "global config: not found"
    fi

    if [ -d ".claude" ]; then
        caddie cli:indent "project config: $(pwd)/.claude"
    else
        caddie cli:indent "project config: not found"
    fi

    if [ -n "${CADDIE_CLAUDE_MODEL:-}" ]; then
        caddie cli:indent "default model: $CADDIE_CLAUDE_MODEL"
    else
        caddie cli:indent "default model: cli default"
    fi

    if [ -n "${CADDIE_CLAUDE_PERMISSION_MODE:-}" ]; then
        caddie cli:indent "default permission mode: $CADDIE_CLAUDE_PERMISSION_MODE"
    else
        caddie cli:indent "default permission mode: cli default"
    fi

    return 0
}

function caddie_claude_run() {
    local prompt="${1:-}"
    local -a command=("claude")

    caddie_claude_require_cli || return 1

    if [ -n "${CADDIE_CLAUDE_MODEL:-}" ]; then
        command+=("--model" "$CADDIE_CLAUDE_MODEL")
    fi
    if [ -n "${CADDIE_CLAUDE_PERMISSION_MODE:-}" ]; then
        command+=("--permission-mode" "$CADDIE_CLAUDE_PERMISSION_MODE")
    fi
    if [ -n "$prompt" ]; then
        command+=("$prompt")
    fi

    "${command[@]}"
    return $?
}

function caddie_claude_print() {
    local prompt="$1"
    shift || true

    if [ -z "$prompt" ]; then
        caddie cli:red "Error: Please provide a prompt"
        caddie cli:usage "caddie claude:print <prompt> [claude-print-options...]"
        return 1
    fi

    caddie_claude_require_cli || return 1

    local -a command=("claude" "-p")
    if [ -n "${CADDIE_CLAUDE_MODEL:-}" ]; then
        command+=("--model" "$CADDIE_CLAUDE_MODEL")
    fi
    if [ -n "${CADDIE_CLAUDE_PERMISSION_MODE:-}" ]; then
        command+=("--permission-mode" "$CADDIE_CLAUDE_PERMISSION_MODE")
    fi
    if [ $# -gt 0 ]; then
        command+=("$@")
    fi
    command+=("$prompt")

    "${command[@]}"
    return $?
}

function caddie_claude_continue() {
    caddie_claude_require_cli || return 1

    local -a command=("claude" "--continue")
    if [ -n "${CADDIE_CLAUDE_MODEL:-}" ]; then
        command+=("--model" "$CADDIE_CLAUDE_MODEL")
    fi
    if [ -n "${CADDIE_CLAUDE_PERMISSION_MODE:-}" ]; then
        command+=("--permission-mode" "$CADDIE_CLAUDE_PERMISSION_MODE")
    fi

    "${command[@]}"
    return $?
}

function caddie_claude_resume() {
    local session_id="${1:-}"

    caddie_claude_require_cli || return 1

    local -a command=("claude" "--resume")
    if [ -n "${CADDIE_CLAUDE_MODEL:-}" ]; then
        command+=("--model" "$CADDIE_CLAUDE_MODEL")
    fi
    if [ -n "${CADDIE_CLAUDE_PERMISSION_MODE:-}" ]; then
        command+=("--permission-mode" "$CADDIE_CLAUDE_PERMISSION_MODE")
    fi
    if [ -n "$session_id" ]; then
        command+=("$session_id")
    fi

    "${command[@]}"
    return $?
}

