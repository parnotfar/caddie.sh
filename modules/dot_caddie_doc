    local file="${1:-README.md}"

    if [ "$file" != "-" ] && [ ! -f "$file" ]; then
        caddie cli:red "Error: File not found: $file"
        caddie cli:usage "caddie doc:preview:glow [file]"
        return 1
    fi

    if ! caddie_doc_has_glow; then
        caddie cli:red "Error: glow not found. Install: brew install glow"
