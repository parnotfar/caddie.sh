#!/usr/bin/env bash

# Caddie.sh - Doc / Markdown Preview
# This file provides markdown preview with user-selectable backends (mdview, glow, mdcat, PDF in Preview)

# Source CLI module for formatting
source "$HOME/.caddie_modules/.caddie_cli"

function caddie_doc_description() {
    printf '%s\n' 'Markdown preview with user-selectable backends (terminal or PDF in Preview)'
    return 0
}

# Rendered directory for PDF output
function caddie_doc_rendered_dir_default() {
    printf '%s\n' "$HOME/.caddie_doc_rendered"
    return 0
}

function caddie_doc_rendered_dir_resolve() {
    local configured="${CADDIE_DOC_RENDERED_DIR:-}"
    local resolved=""

    if [ -n "$configured" ]; then
        resolved="$(eval echo "$configured")"
        if [ -n "$resolved" ]; then
            printf '%s\n' "$(cd "$resolved" 2>/dev/null && pwd)" || printf '%s\n' "$resolved"
            return 0
        fi
    fi
    printf '%s\n' "$(caddie_doc_rendered_dir_default)"
    return 0
}

function caddie_doc_rendered_dir_set() {
    local value="$1"

    if [ -z "$value" ]; then
        caddie cli:red "Error: Please provide a directory path"
        caddie cli:usage "caddie doc:rendered:dir:set <path>"
        return 1
    fi

    local expanded_path
    expanded_path="$(eval echo "$value")"
    if [ ! -d "$expanded_path" ]; then
        mkdir -p "$expanded_path" || true
        if [ ! -d "$expanded_path" ]; then
            caddie cli:red "Error: Could not create directory: $expanded_path"
            return 1
        fi
    fi

    local absolute_path
    absolute_path="$(cd "$expanded_path" && pwd)"
    export CADDIE_DOC_RENDERED_DIR="$absolute_path"
    caddie cli:check "Rendered directory set to: $absolute_path"
    return 0
}

function caddie_doc_rendered_dir_get() {
    local value="${CADDIE_DOC_RENDERED_DIR:-}"
    local default_dir=""

    default_dir="$(caddie_doc_rendered_dir_default)"

    if [ -n "$value" ]; then
        caddie cli:green "Rendered directory: $value"
    else
        caddie cli:yellow "No rendered directory is set"
        caddie cli:thought "Default: $default_dir"
        caddie cli:thought "Use 'caddie doc:rendered:dir:set <path>' to override"
    fi
    return 0
}

function caddie_doc_rendered_dir_unset() {
    if [ -n "${CADDIE_DOC_RENDERED_DIR:-}" ]; then
        unset CADDIE_DOC_RENDERED_DIR
        caddie cli:check "Rendered directory unset"
    else
        caddie cli:yellow "No rendered directory was set"
    fi
    return 0
}

# Preferred backend: mdview, glow, mdcat, pdf
function caddie_doc_prefer_set() {
    local value="$1"

    if [ -z "$value" ]; then
        caddie cli:red "Error: Please provide a backend name"
        caddie cli:usage "caddie doc:prefer:set <mdview|glow|mdcat|pdf>"
        caddie cli:thought "Options: mdview (terminal + mermaid), glow, mdcat, pdf (Preview app)"
        return 1
    fi

    case "$value" in
        mdview|glow|mdcat|pdf)
            export CADDIE_DOC_PREFER="$value"
            caddie cli:check "Preferred preview backend set to: $value"
            return 0
            ;;
        *)
            caddie cli:red "Error: Unknown backend '$value'"
            caddie cli:thought "Options: mdview, glow, mdcat, pdf"
            return 1
            ;;
    esac
}

function caddie_doc_prefer_get() {
    local value="${CADDIE_DOC_PREFER:-}"

    if [ -n "$value" ]; then
        caddie cli:green "Preferred backend: $value"
    else
        caddie cli:yellow "No preference set (will use first available: mdview → glow → mdcat → pandoc/less)"
        caddie cli:thought "Use 'caddie doc:prefer:set <backend>' to set"
    fi
    return 0
}

function caddie_doc_prefer_unset() {
    if [ -n "${CADDIE_DOC_PREFER:-}" ]; then
        unset CADDIE_DOC_PREFER
        caddie cli:check "Preferred backend unset"
    else
        caddie cli:yellow "No preference was set"
    fi
    return 0
}

# Detect which backends are available
function caddie_doc_has_mdview() {
    command -v mdview >/dev/null 2>&1
    return $?
}

function caddie_doc_has_glow() {
    command -v glow >/dev/null 2>&1
    return $?
}

function caddie_doc_has_mdcat() {
    command -v mdcat >/dev/null 2>&1
    return $?
}

function caddie_doc_has_pandoc() {
    command -v pandoc >/dev/null 2>&1
    return $?
}

# Resolve which backend to use (prefer setting or fallback order)
function caddie_doc_resolve_backend() {
    local prefer="${CADDIE_DOC_PREFER:-}"

    if [ -n "$prefer" ]; then
        case "$prefer" in
            mdview) caddie_doc_has_mdview && { printf '%s\n' "mdview"; return 0; } ;;
            glow)   caddie_doc_has_glow   && { printf '%s\n' "glow";   return 0; } ;;
            mdcat)  caddie_doc_has_mdcat  && { printf '%s\n' "mdcat";  return 0; } ;;
            pdf)    caddie_doc_has_pandoc && { printf '%s\n' "pdf";    return 0; } ;;
        esac
    fi

    if caddie_doc_has_mdview; then printf '%s\n' "mdview"; return 0; fi
    if caddie_doc_has_glow;   then printf '%s\n' "glow";   return 0; fi
    if caddie_doc_has_mdcat;  then printf '%s\n' "mdcat";  return 0; fi
    if caddie_doc_has_pandoc; then printf '%s\n' "pandoc"; return 0; fi
    printf '%s\n' ""
    return 1
}

# Main preview: use preferred or fallback, then run appropriate viewer
function caddie_doc_preview() {
    local file="${1:-README.md}"

    if [ "$file" = "-" ]; then
        file="-"
    else
        if [ "$file" != "-" ] && [ ! -f "$file" ]; then
            caddie cli:red "Error: File not found: $file"
            caddie cli:usage "caddie doc:preview [file]"
            return 1
        fi
    fi

    local backend
    backend="$(caddie_doc_resolve_backend)"
    if [ -z "$backend" ]; then
        if [ "$file" != "-" ]; then
            caddie cli:thought "No rich viewer installed; showing file in less. Run 'caddie doc:setup' to choose and install a viewer."
            less -R "$file"
            return $?
        fi
        caddie cli:red "Error: No markdown viewer available and no file path for fallback."
        caddie cli:thought "Install a viewer: caddie doc:setup:mdview | doc:setup:glow | doc:setup:mdcat | doc:setup:pandoc"
        return 1
    fi

    case "$backend" in
        mdview)
            if [ "$file" = "-" ]; then
                mdview -
            else
                mdview "$file"
            fi
            ;;
        glow)
            if [ "$file" = "-" ]; then
                glow -
            else
                glow "$file" -p
            fi
            ;;
        mdcat)
            if [ "$file" = "-" ]; then
                mdcat -
            else
                mdcat "$file"
            fi
            ;;
        pdf)
            if [ "$file" = "-" ]; then
                caddie cli:red "Error: PDF preview requires a file path (no stdin)"
                return 1
            fi
            caddie_doc_preview_pdf "$file"
            return $?
            ;;
        pandoc)
            if [ "$file" = "-" ]; then
                caddie cli:red "Error: Fallback requires a file path (no stdin)"
                return 1
            fi
            less -R "$file"
            ;;
        *)
            caddie cli:red "Error: Unknown backend: $backend"
            return 1
            ;;
    esac
    return $?
}

function caddie_doc_preview_mdview() {
    local file="${1:-README.md}"

    if [ "$file" != "-" ] && [ ! -f "$file" ]; then
        caddie cli:red "Error: File not found: $file"
        caddie cli:usage "caddie doc:preview:mdview [file]"
        return 1
    fi

    if ! caddie_doc_has_mdview; then
        caddie cli:red "Error: mdview not found. Install: curl -fsSL https://raw.githubusercontent.com/tzachbon/mdview/main/install.sh | sh"
        return 1
    fi

    if [ "$file" = "-" ]; then
        mdview -
    else
        mdview "$file"
    fi
    return $?
}

