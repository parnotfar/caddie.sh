function caddie_doc_preview_pdf() {
    local file="${1:-}"

    if [ -z "$file" ]; then
        caddie cli:red "Error: Please provide a markdown file"
        caddie cli:usage "caddie doc:preview:pdf <file>"
        return 1
    fi

    if [ ! -f "$file" ]; then
        caddie cli:red "Error: File not found: $file"
        return 1
    fi

    if ! caddie_doc_has_pandoc; then
        caddie cli:red "Error: pandoc not found. Install: brew install pandoc"
        return 1
    fi

    local rendered_dir
    rendered_dir="$(caddie_doc_rendered_dir_resolve)"
    if [ ! -d "$rendered_dir" ]; then
        mkdir -p "$rendered_dir" || {
            caddie cli:red "Error: Could not create rendered directory: $rendered_dir"
            return 1
        }
    fi

    local base
    base="$(basename "$file" .md)"
    local pdf_path="$rendered_dir/${base}.pdf"

    caddie cli:title "Rendering $file to PDF"
    if ! pandoc -s -f markdown -t pdf -o "$pdf_path" "$file" 2>/dev/null; then
        pandoc -s -f markdown -t html "$file" 2>/dev/null | pandoc -s -f html -t pdf -o "$pdf_path" 2>/dev/null || {
            caddie cli:red "Error: pandoc PDF conversion failed"
            return 1
        }
    fi

    caddie cli:check "PDF written to: $pdf_path"

    if [ "$(uname -s)" = "Darwin" ]; then
        open "$pdf_path"
        caddie cli:check "Opened in Preview"
    else
        if command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$pdf_path"
        else
            caddie cli:indent "Open manually: $pdf_path"
        fi
    fi
    return 0
}

function caddie_doc_preview_clean() {
    local rendered_dir
    rendered_dir="$(caddie_doc_rendered_dir_resolve)"

    if [ ! -d "$rendered_dir" ]; then
        caddie cli:yellow "Rendered directory does not exist: $rendered_dir"
        return 0
    fi

    local count
    count="$(find "$rendered_dir" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')"
    if [ "${count:-0}" -eq 0 ]; then
        caddie cli:indent "No files to remove in $rendered_dir"
        return 0
    fi

    caddie cli:title "Removing rendered files from $rendered_dir"
    find "$rendered_dir" -maxdepth 1 -type f -delete 2>/dev/null || true
    caddie cli:check "Cleanup complete"
    return 0
}

function caddie_doc_info() {
    local backend=""
    local rendered_dir=""

    caddie cli:title "Doc / Markdown Preview Info"
    caddie cli:blank

    caddie cli:title "Backends:"
    if caddie_doc_has_mdview; then caddie cli:check "mdview (terminal + mermaid)"; else caddie cli:x "mdview"; fi
    if caddie_doc_has_glow;   then caddie cli:check "glow";   else caddie cli:x "glow"; fi
    if caddie_doc_has_mdcat;  then caddie cli:check "mdcat";  else caddie cli:x "mdcat"; fi
    if caddie_doc_has_pandoc; then caddie cli:check "pandoc (PDF)"; else caddie cli:x "pandoc"; fi

    caddie cli:blank
    caddie cli:title "Preference:"
    if [ -n "${CADDIE_DOC_PREFER:-}" ]; then
        caddie cli:indent "CADDIE_DOC_PREFER=$CADDIE_DOC_PREFER"
    else
        caddie cli:indent "none (auto: mdview → glow → mdcat → pandoc)"
    fi

    backend="$(caddie_doc_resolve_backend)"
    if [ -n "$backend" ]; then
        caddie cli:indent "default for doc:preview: $backend"
    else
        caddie cli:yellow "no backend available"
    fi

    caddie cli:blank
    caddie cli:title "Rendered directory (PDF output):"
    rendered_dir="$(caddie_doc_rendered_dir_resolve)"
    caddie cli:indent "$rendered_dir"
    return 0
}

function caddie_doc_setup_mdview() {
    if caddie_doc_has_mdview; then
        caddie cli:check "mdview already installed: $(command -v mdview)"
        caddie_doc_prefer_set "mdview"
        return 0
    fi
    caddie cli:title "Installing mdview (terminal markdown + Mermaid)"
    if curl -fsSL https://raw.githubusercontent.com/tzachbon/mdview/main/install.sh | sh; then
        caddie cli:check "mdview installed"
        if command -v mdview >/dev/null 2>&1; then
            caddie_doc_prefer_set "mdview"
        fi
        return 0
    fi
    caddie cli:x "mdview install failed"
    return 1
}

function caddie_doc_setup_glow() {
    if caddie_doc_has_glow; then
        caddie cli:check "glow already installed: $(command -v glow)"
        caddie_doc_prefer_set "glow"
        return 0
    fi
    if ! command -v brew >/dev/null 2>&1; then
        caddie cli:red "Error: Homebrew not found. Install from https://brew.sh"
        return 1
    fi
    caddie cli:title "Installing glow via Homebrew"
    if brew install glow; then
        caddie cli:check "glow installed"
        if command -v glow >/dev/null 2>&1; then
            caddie_doc_prefer_set "glow"
        fi
        return 0
    fi
    caddie cli:x "glow install failed"
    return 1
}

function caddie_doc_setup_mdcat() {
    if caddie_doc_has_mdcat; then
        caddie cli:check "mdcat already installed: $(command -v mdcat)"
        caddie_doc_prefer_set "mdcat"
        return 0
    fi
    if ! command -v cargo >/dev/null 2>&1; then
        caddie cli:red "Error: Cargo not found. Install Rust first, e.g. caddie rust:setup or https://rustup.rs"
        return 1
    fi
    caddie cli:title "Installing mdcat via Cargo"
    if cargo install mdcat; then
        caddie cli:check "mdcat installed"
        if command -v mdcat >/dev/null 2>&1; then
            caddie_doc_prefer_set "mdcat"
        fi
        return 0
    fi
    caddie cli:x "mdcat install failed"
    return 1
}

function caddie_doc_setup_pandoc() {
    if caddie_doc_has_pandoc; then
        caddie cli:check "pandoc already installed: $(command -v pandoc)"
        caddie_doc_prefer_set "pdf"
        return 0
    fi
    if ! command -v brew >/dev/null 2>&1; then
        caddie cli:red "Error: Homebrew not found. Install from https://brew.sh"
        return 1
    fi
    caddie cli:title "Installing pandoc via Homebrew (for doc:preview:pdf)"
    if brew install pandoc; then
        caddie cli:check "pandoc installed"
        if command -v pandoc >/dev/null 2>&1; then
            caddie_doc_prefer_set "pdf"
        fi
        return 0
    fi
    caddie cli:x "pandoc install failed"
    return 1
}

function caddie_doc_install_mdview() {
    caddie_doc_setup_mdview
    return $?
}

function caddie_doc_install_glow() {
    caddie_doc_setup_glow
    return $?
}

function caddie_doc_install_mdcat() {
    caddie_doc_setup_mdcat
    return $?
}

function caddie_doc_install_pandoc() {
    caddie_doc_setup_pandoc
    return $?
}

function caddie_doc_setup() {
    local answer=""
    local choice=""

    caddie cli:title "Doc / Markdown Preview Setup"
    caddie cli:blank
    caddie cli:indent "Install a viewer with: caddie doc:setup:mdview | doc:setup:glow | doc:setup:mdcat | doc:setup:pandoc"
    caddie cli:blank
    caddie cli:title "Backends:"
    if caddie_doc_has_mdview; then
        caddie cli:check "mdview (terminal + Mermaid)"
    else
        caddie cli:indent "mdview: caddie doc:setup:mdview"
    fi
    if caddie_doc_has_glow; then
        caddie cli:check "glow"
    else
        caddie cli:indent "glow:   caddie doc:setup:glow"
    fi
    if caddie_doc_has_mdcat; then
        caddie cli:check "mdcat"
    else
        caddie cli:indent "mdcat:  caddie doc:setup:mdcat (requires Rust)"
    fi
    if caddie_doc_has_pandoc; then
        caddie cli:check "pandoc (for PDF)"
    else
        caddie cli:indent "pandoc: caddie doc:setup:pandoc"
    fi
    caddie cli:blank

    if [ -t 0 ]; then
        read -r -p "Install which? (mdview/glow/mdcat/pandoc or Enter to skip): " answer || true
        choice="$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
        if [ -n "$choice" ]; then
            case "$choice" in
                mdview)
                    caddie_doc_setup_mdview
                    return $?
                    ;;
                glow)
                    caddie_doc_setup_glow
                    return $?
                    ;;
                mdcat)
                    caddie_doc_setup_mdcat
                    return $?
                    ;;
                pandoc)
                    caddie_doc_setup_pandoc
                    return $?
                    ;;
                *)
                    caddie cli:yellow "Unknown choice. Run e.g. caddie doc:setup:mdview"
                    ;;
            esac
        fi
    fi
    return 0
}

