function caddie_ledger_collect() {
    local repo_root=""
    local session_id=""
    local checkpoint_id=""
    local checkpoint_dir=""
    local transcript_path=""
    local watch_file=""
    local watch_agent=""
    local lines_to_collect="${CADDIE_LEDGER_COLLECT_LINES:-200}"
    local collect_started_at=""
    local source_info=""
    local source_state=""
    local source_path=""
    local collected_count=0
    local skipped_count=0
    local block_language=""

    if [ -z "$(printf '%s' "$lines_to_collect" | sed -nE 's#^[0-9]+$#ok#p')" ]; then
        lines_to_collect="200"
    fi

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    session_id="$(caddie_ledger_active_session_id "$repo_root")"
    if [ -z "$session_id" ]; then
        caddie cli:red "Error: No active ledger session"
        caddie cli:usage "caddie ledger:session:start [agents...]"
        return 1
    fi

    checkpoint_id="$(caddie_ledger_active_checkpoint_id "$repo_root")"
    if [ -z "$checkpoint_id" ]; then
        caddie cli:red "Error: No active checkpoint"
        caddie cli:thought "Create one with: caddie ledger:checkpoint [message]"
        return 1
    fi

    checkpoint_dir="$(caddie_ledger_find_checkpoint_dir "$repo_root" "$checkpoint_id")"
    if [ -z "$checkpoint_dir" ] || [ ! -d "$checkpoint_dir" ]; then
        caddie cli:red "Error: Active checkpoint directory not found"
        return 1
    fi

    transcript_path="${checkpoint_dir}/transcripts/checkpoint.md"
    watch_file="$(caddie_ledger_session_watch_file "$repo_root" "$session_id")"

    if [ ! -f "$watch_file" ] || [ ! -s "$watch_file" ]; then
        caddie cli:red "Error: No watched agents configured for this session"
        caddie cli:thought "Use: caddie ledger:agent:watch codex cursor"
        return 1
    fi

    if [ ! -f "$transcript_path" ]; then
        cat > "$transcript_path" <<EOF
# Checkpoint Transcript

- checkpoint_id: ${checkpoint_id}
- session_id: ${session_id}
EOF
    fi

    collect_started_at="$(caddie_ledger_timestamp_utc)"
    {
        printf '\n## Collected Sources (%s)\n\n' "$collect_started_at"
    } >> "$transcript_path"

    while IFS= read -r watch_agent; do
        if [ -z "$watch_agent" ]; then
            continue
        fi

        source_info="$(caddie_ledger_collect_source_info "$watch_agent")"
        source_state="$(printf '%s' "$source_info" | cut -d'|' -f1)"
        source_path="$(printf '%s' "$source_info" | cut -d'|' -f2-)"

        {
            printf '### %s\n\n' "$watch_agent"
        } >> "$transcript_path"

        if [ "$source_state" != "ready" ]; then
            if [ -n "$source_path" ]; then
                printf 'source: %s\n\n' "$source_path" >> "$transcript_path"
            fi
            printf 'status: %s\n\n' "$source_state" >> "$transcript_path"
            skipped_count=$((skipped_count + 1))
            continue
        fi

        case "$watch_agent" in
            codex|caddie)
                if [ "$watch_agent" = "codex" ]; then
                    block_language="jsonl"
                else
                    block_language="text"
                fi
                printf 'source: %s\n\n' "$source_path" >> "$transcript_path"
                printf 'status: collected (%s lines)\n\n' "$lines_to_collect" >> "$transcript_path"
                printf '```%s\n' "$block_language" >> "$transcript_path"
                tail -n "$lines_to_collect" "$source_path" >> "$transcript_path"
                printf '\n```\n\n' >> "$transcript_path"
                collected_count=$((collected_count + 1))
                ;;
            cursor)
                printf 'source: %s\n\n' "$source_path" >> "$transcript_path"
                printf 'status: detected, collector not yet implemented\n\n' >> "$transcript_path"
                skipped_count=$((skipped_count + 1))
                ;;
            *)
                printf 'status: unsupported\n\n' >> "$transcript_path"
                skipped_count=$((skipped_count + 1))
                ;;
        esac
    done < "$watch_file"

    caddie cli:check "Ledger collect completed"
    caddie cli:indent "checkpoint: $checkpoint_id"
    caddie cli:indent "transcript: $transcript_path"
    caddie cli:indent "collected: $collected_count"
    caddie cli:indent "skipped: $skipped_count"
    return 0
}

function caddie_ledger_session_end() {
    local repo_root=""
    local session_id=""
    local session_dir=""
    local session_file=""
    local ended_at=""
    local session_agent=""
    local session_started_at=""
    local checkpoint_count=""
    local last_checkpoint_id=""
    local current_session_file=""
    local current_checkpoint_file=""

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    session_id="$(caddie_ledger_active_session_id "$repo_root")"
    if [ -z "$session_id" ]; then
        caddie cli:red "Error: No active ledger session"
        caddie cli:usage "caddie ledger:session:start [agents...]"
        return 1
    fi

    session_dir="$(caddie_ledger_sessions_dir "$repo_root")/${session_id}"
    session_file="${session_dir}/session.json"
    if [ ! -f "$session_file" ]; then
        caddie cli:red "Error: Active session metadata was not found"
        return 1
    fi

    session_agent="$(caddie_ledger_json_read_string "$session_file" "agent")"
    session_started_at="$(caddie_ledger_json_read_string "$session_file" "started_at")"
    checkpoint_count="$(caddie_ledger_json_read_number "$session_file" "checkpoint_count")"
    last_checkpoint_id="$(caddie_ledger_json_read_string "$session_file" "last_checkpoint_id")"
    ended_at="$(caddie_ledger_timestamp_utc)"

    if [ -z "$session_agent" ]; then
        session_agent="unknown"
    fi
    if [ -z "$session_started_at" ]; then
        session_started_at="$ended_at"
    fi
    if [ -z "$checkpoint_count" ]; then
        checkpoint_count="0"
    fi

    if ! caddie_ledger_write_session_json \
        "$session_file" \
        "$session_id" \
        "$session_agent" \
        "$session_started_at" \
        "$checkpoint_count" \
        "$last_checkpoint_id" \
        "$ended_at"; then
        caddie cli:red "Error: Unable to finalize session metadata"
        return 1
    fi

    current_session_file="$(caddie_ledger_current_session_file "$repo_root")"
    current_checkpoint_file="$(caddie_ledger_current_checkpoint_file "$repo_root")"
    rm -f "$current_session_file" "$current_checkpoint_file"

    caddie cli:check "Ledger session ended"
    caddie cli:indent "session: $session_id"
    caddie cli:indent "ended_at: $ended_at"
    return 0
}

function caddie_ledger_checkpoint() {
    local message="$1"
    local repo_root=""
    local session_id=""
    local session_dir=""
    local session_file=""
    local checkpoints_dir=""
    local checkpoint_id=""
    local checkpoint_dir=""
    local transcripts_dir=""
    local artifacts_dir=""
    local verification_dir=""
    local manifest_path=""
    local verify_log_path=""
    local files_hashes_path=""
    local transcript_path=""
    local timestamp=""
    local branch=""
    local git_sha=""
    local snapshot_summary=""
    local file_count=0
    local total_bytes=0
    local tree_hash="none"
    local snapshot_hash=""
    local verify_command=""
    local verify_exit=0
    local verify_status="passed"
    local artifact_count=0
    local checkpoint_count=0
    local session_agent=""
    local session_started_at=""
    local session_ended_at=""
    local current_checkpoint_file=""
    local collect_status="skipped"

    if [ -z "$message" ]; then
        message="checkpoint"
    fi

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    session_id="$(caddie_ledger_active_session_id "$repo_root")"
    if [ -z "$session_id" ]; then
        caddie cli:red "Error: No active ledger session"
        caddie cli:usage "caddie ledger:session:start [agents...]"
        return 1
    fi

    session_dir="$(caddie_ledger_sessions_dir "$repo_root")/${session_id}"
    session_file="${session_dir}/session.json"
    checkpoints_dir="${session_dir}/checkpoints"
    if [ ! -d "$checkpoints_dir" ]; then
        caddie cli:red "Error: Active session is missing checkpoints directory"
        return 1
    fi

    checkpoint_id="$(caddie_ledger_new_checkpoint_id "$checkpoints_dir")"
    checkpoint_dir="${checkpoints_dir}/${checkpoint_id}"
    transcripts_dir="${checkpoint_dir}/transcripts"
    artifacts_dir="${checkpoint_dir}/artifacts"
    verification_dir="${checkpoint_dir}/verification"
    manifest_path="${checkpoint_dir}/manifest.json"
    verify_log_path="${verification_dir}/verify.log"
    files_hashes_path="${verification_dir}/files.sha256"
    transcript_path="${transcripts_dir}/checkpoint.md"
    timestamp="$(caddie_ledger_timestamp_utc)"
    branch="$(caddie_ledger_git_branch "$repo_root")"
    git_sha="$(caddie_ledger_git_sha "$repo_root")"
    current_checkpoint_file="$(caddie_ledger_current_checkpoint_file "$repo_root")"

    if ! mkdir -p "$transcripts_dir" "$artifacts_dir" "$verification_dir"; then
        caddie cli:red "Error: Unable to create checkpoint directory structure"
        return 1
    fi
    : > "${artifacts_dir}/index.jsonl"

    snapshot_summary="$(caddie_ledger_snapshot_build "$repo_root" "$checkpoint_dir" "$files_hashes_path")" || return 1
    file_count="$(printf '%s' "$snapshot_summary" | cut -d'|' -f1)"
    total_bytes="$(printf '%s' "$snapshot_summary" | cut -d'|' -f2)"
    tree_hash="$(printf '%s' "$snapshot_summary" | cut -d'|' -f3)"
    snapshot_hash="$(printf '%s' "$snapshot_summary" | cut -d'|' -f4)"

    cat > "$transcript_path" <<EOF
# Checkpoint Transcript

- checkpoint_id: ${checkpoint_id}
- session_id: ${session_id}
- created_at: ${timestamp}
- message: ${message}
EOF

    verify_command="$(caddie_ledger_verification_command_resolve)"
    if (cd "$repo_root" && eval "$verify_command") > "$verify_log_path" 2>&1; then
        verify_exit=0
        verify_status="passed"
    else
        verify_exit=$?
        verify_status="failed"
    fi

    if ! caddie_ledger_write_manifest \
        "$manifest_path" \
        "$repo_root" \
        "$session_id" \
        "$checkpoint_id" \
        "$timestamp" \
        "$message" \
        "$branch" \
        "$git_sha" \
        "$file_count" \
        "$total_bytes" \
        "$tree_hash" \
        "$snapshot_hash" \
        "$verify_command" \
        "$verify_exit" \
        "$verify_status" \
        "$artifact_count"; then
        caddie cli:red "Error: Unable to write checkpoint manifest"
        return 1
    fi

    printf '%s\n' "$checkpoint_id" > "$current_checkpoint_file"
    if caddie_ledger_collect >/dev/null 2>&1; then
        collect_status="collected"
    fi

    checkpoint_count="$(find "$checkpoints_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d '[:space:]')"
    if [ -z "$checkpoint_count" ]; then
        checkpoint_count=0
    fi
    session_agent="$(caddie_ledger_json_read_string "$session_file" "agent")"
    session_started_at="$(caddie_ledger_json_read_string "$session_file" "started_at")"
    session_ended_at="$(caddie_ledger_json_read_string "$session_file" "ended_at")"
    if [ -z "$session_agent" ]; then
        session_agent="unknown"
    fi
    if [ -z "$session_started_at" ]; then
        session_started_at="$timestamp"
    fi
    caddie_ledger_write_session_json "$session_file" "$session_id" "$session_agent" "$session_started_at" "$checkpoint_count" "$checkpoint_id" "$session_ended_at" >/dev/null 2>&1 || true

    caddie cli:check "Ledger checkpoint created"
    caddie cli:indent "checkpoint: $checkpoint_id"
    caddie cli:indent "snapshot: ${checkpoint_dir}/snapshot.zip"
    caddie cli:indent "verification: ${verify_status} (${verify_command})"
    caddie cli:indent "collect: ${collect_status}"
    caddie cli:indent "manifest: $manifest_path"
    if [ "$collect_status" != "collected" ]; then
        caddie cli:yellow "Automatic collect skipped for this checkpoint"
        caddie cli:thought "Run: caddie ledger:collect"
    fi

    if [ "$verify_exit" -ne 0 ]; then
        caddie cli:yellow "Verification failed for this checkpoint (see verify.log)"
    fi
    return 0
}

function caddie_ledger_artifact() {
    local artifact_path="$1"
    local repo_root=""
    local checkpoint_id=""
    local checkpoint_dir=""
    local artifacts_dir=""
    local index_file=""
    local manifest_path=""
    local source_path=""
    local source_name=""
    local dest_path=""
    local dest_name=""
    local timestamp=""
    local escaped_source=""
    local escaped_dest=""
    local artifact_count=0

    if [ -z "$artifact_path" ]; then
        caddie cli:red "Error: Please provide a file or directory path"
        caddie cli:usage "caddie ledger:artifact <path>"
        return 1
    fi

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    checkpoint_id="$(caddie_ledger_active_checkpoint_id "$repo_root")"
    if [ -z "$checkpoint_id" ]; then
        caddie cli:red "Error: No active checkpoint"
        caddie cli:thought "Create one with: caddie ledger:checkpoint [message]"
        return 1
    fi

    checkpoint_dir="$(caddie_ledger_find_checkpoint_dir "$repo_root" "$checkpoint_id")"
    if [ -z "$checkpoint_dir" ] || [ ! -d "$checkpoint_dir" ]; then
        caddie cli:red "Error: Active checkpoint directory not found"
        return 1
    fi

    artifacts_dir="${checkpoint_dir}/artifacts"
    index_file="${artifacts_dir}/index.jsonl"
    manifest_path="${checkpoint_dir}/manifest.json"

    if [ ! -e "$artifact_path" ]; then
        caddie cli:red "Error: Artifact path does not exist: $artifact_path"
        return 1
    fi

    source_path="$(cd "$(dirname "$artifact_path")" && pwd)/$(basename "$artifact_path")"
    source_name="$(basename "$source_path")"
    dest_name="$source_name"
    dest_path="${artifacts_dir}/${dest_name}"
    timestamp="$(date -u +"%Y%m%dT%H%M%SZ")"

    if [ -e "$dest_path" ]; then
        dest_name="${source_name}-${timestamp}"
        dest_path="${artifacts_dir}/${dest_name}"
    fi

    if [ -d "$source_path" ]; then
        if ! cp -R "$source_path" "$dest_path"; then
            caddie cli:red "Error: Unable to copy artifact directory"
            return 1
        fi
    else
        if ! cp -p "$source_path" "$dest_path"; then
            caddie cli:red "Error: Unable to copy artifact file"
            return 1
        fi
    fi

    escaped_source="$(caddie_ledger_json_escape "$source_path")"
    escaped_dest="$(caddie_ledger_json_escape "artifacts/${dest_name}")"
    printf '{"added_at":"%s","source_path":"%s","stored_path":"%s"}\n' \
        "$(caddie_ledger_timestamp_utc)" \
        "$escaped_source" \
        "$escaped_dest" >> "$index_file"

    artifact_count="$(wc -l < "$index_file" | tr -d '[:space:]')"
    if [ -z "$artifact_count" ]; then
        artifact_count=0
    fi

    if ! caddie_ledger_manifest_update_artifact_count "$manifest_path" "$artifact_count"; then
        caddie cli:yellow "Artifact copied, but manifest artifact count could not be updated"
    fi

    caddie cli:check "Artifact attached to checkpoint $checkpoint_id"
    caddie cli:indent "stored as: artifacts/${dest_name}"
    return 0
}

function caddie_ledger_list() {
    local repo_root=""
    local ledger_dir=""
    local sessions_dir=""
    local project_file=""
    local active_session=""
    local active_checkpoint=""
    local manifest=""
    local found_any=0
    local session_id=""
    local checkpoint_id=""
    local created_at=""
    local message=""
    local verification_status=""

    repo_root="$(caddie_ledger_repo_root)"
    ledger_dir="$(caddie_ledger_dir "$repo_root")"
    sessions_dir="$(caddie_ledger_sessions_dir "$repo_root")"
    project_file="$(caddie_ledger_project_file "$repo_root")"

    if [ ! -f "$project_file" ]; then
        caddie cli:red "Error: Ledger project is not initialized"
        caddie cli:usage "caddie ledger:project:init"
        return 1
    fi

    active_session="$(caddie_ledger_active_session_id "$repo_root")"
    active_checkpoint="$(caddie_ledger_active_checkpoint_id "$repo_root")"

    caddie cli:title "Ledger Checkpoints"
    caddie cli:indent "repo root: $repo_root"
    caddie cli:indent "ledger dir: $ledger_dir"
    if [ -n "$active_session" ]; then
        caddie cli:indent "active session: $active_session"
    else
        caddie cli:indent "active session: none"
    fi
    if [ -n "$active_checkpoint" ]; then
        caddie cli:indent "active checkpoint: $active_checkpoint"
    else
        caddie cli:indent "active checkpoint: none"
    fi
    caddie cli:blank

    if [ ! -d "$sessions_dir" ]; then
        caddie cli:yellow "No sessions found"
        return 0
    fi

    while IFS= read -r manifest; do
        found_any=1
        session_id="$(caddie_ledger_json_read_string "$manifest" "session_id")"
        checkpoint_id="$(caddie_ledger_json_read_string "$manifest" "checkpoint_id")"
        created_at="$(caddie_ledger_json_read_string "$manifest" "created_at")"
        message="$(caddie_ledger_json_read_string "$manifest" "message")"
        verification_status="$(caddie_ledger_json_read_string "$manifest" "status")"

        if [ -z "$message" ]; then
            message="(no message)"
        fi
        if [ -z "$verification_status" ]; then
            verification_status="unknown"
        fi

        caddie cli:indent "${created_at}  ${session_id}  ${checkpoint_id}  [${verification_status}]  ${message}"
    done < <(find "$sessions_dir" -type f -name manifest.json 2>/dev/null | sort)

    if [ "$found_any" -eq 0 ]; then
        caddie cli:yellow "No checkpoints found"
    fi
    return 0
}

function caddie_ledger_restore() {
    local checkpoint_id="$1"
    local target_dir="$2"
    local repo_root=""
    local checkpoint_dir=""
    local snapshot_path=""
    local restore_root=""
    local timestamp=""
    local non_empty_marker=""

    if [ -z "$checkpoint_id" ]; then
        caddie cli:red "Error: Please provide a checkpoint id"
        caddie cli:usage "caddie ledger:restore <checkpoint_id> [target_dir]"
        return 1
    fi

    if ! command -v unzip >/dev/null 2>&1; then
        caddie cli:red "Error: 'unzip' command is required for ledger restore"
        return 1
    fi

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    checkpoint_dir="$(caddie_ledger_find_checkpoint_dir "$repo_root" "$checkpoint_id")"
    if [ -z "$checkpoint_dir" ]; then
        caddie cli:red "Error: Checkpoint not found: $checkpoint_id"
        return 1
    fi

    snapshot_path="${checkpoint_dir}/snapshot.zip"
    if [ ! -f "$snapshot_path" ]; then
        caddie cli:red "Error: Snapshot archive is missing for checkpoint $checkpoint_id"
        return 1
    fi

    if [ -z "$target_dir" ]; then
        restore_root="$(caddie_ledger_dir "$repo_root")/restores"
        timestamp="$(date -u +"%Y%m%dT%H%M%SZ")"
        target_dir="${restore_root}/${checkpoint_id}-${timestamp}"
    fi

    if [ -e "$target_dir" ]; then
        non_empty_marker="$(find "$target_dir" -mindepth 1 -print -quit 2>/dev/null || true)"
        if [ -n "$non_empty_marker" ]; then
            caddie cli:red "Error: Restore target exists and is not empty: $target_dir"
            caddie cli:thought "Use a new directory or pass an empty directory"
            return 1
        fi
    else
        if ! mkdir -p "$target_dir"; then
            caddie cli:red "Error: Unable to create restore target directory"
            return 1
        fi
    fi

    if ! unzip -q "$snapshot_path" -d "$target_dir"; then
        caddie cli:red "Error: Unable to restore snapshot archive"
        return 1
    fi

    caddie cli:check "Checkpoint restored"
    caddie cli:indent "checkpoint: $checkpoint_id"
    caddie cli:indent "restored to: $target_dir"
    return 0
}

function caddie_ledger_auth_set() {
