    fi

    value="$(sed -n "s/^[[:space:]]*\"${key}\":[[:space:]]*\\([0-9][0-9]*\\)[[:space:]]*,\\{0,1\\}[[:space:]]*$/\\1/p" "$file_path" | head -n 1)"
    printf '%s' "$value"
    return 0
}

