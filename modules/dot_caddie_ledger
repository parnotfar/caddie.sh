function caddie_ledger_schema_db_url_has_inline_password() {
    local db_url="$1"

    if [ -n "$(printf '%s' "$db_url" | sed -nE 's#^[a-zA-Z0-9+.-]+://[^/@]+:[^@]*@.*$#yes#p')" ]; then
        return 0
    fi

    return 1
}

function caddie_ledger_schema_db_url_resolve_from_input() {
    local input="$1"
    local host=""
    local user=""
    local port=""
    local name=""

    if [ -z "$input" ]; then
        caddie_ledger_schema_db_url_get_value
        return 0
    fi

    if caddie_ledger_schema_db_value_is_url "$input"; then
        printf '%s' "$input"
        return 0
    fi

