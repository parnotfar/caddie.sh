function caddie_ledger_supabase_json_request() {
    local supabase_url="$1"
    local supabase_anon_key="$2"
    local method="$3"
    local path="$4"
    local payload="$5"
    local prefer_header="$6"
    local response_file="$7"
    local http_code=""
    local body_preview=""

    if [ -z "$method" ] || [ -z "$path" ] || [ -z "$response_file" ]; then
        return 1
    fi

    if [ -n "$payload" ]; then
        if [ -n "$prefer_header" ]; then
            http_code="$(curl -sS -X "$method" \
                "${supabase_url}${path}" \
                -H "apikey: ${supabase_anon_key}" \
                -H "Authorization: Bearer ${supabase_anon_key}" \
                -H "Content-Type: application/json" \
                -H "Prefer: ${prefer_header}" \
                --data "$payload" \
                -o "$response_file" \
                -w "%{http_code}")"
        else
            http_code="$(curl -sS -X "$method" \
                "${supabase_url}${path}" \
                -H "apikey: ${supabase_anon_key}" \
                -H "Authorization: Bearer ${supabase_anon_key}" \
                -H "Content-Type: application/json" \
                --data "$payload" \
                -o "$response_file" \
                -w "%{http_code}")"
        fi
    else
        if [ -n "$prefer_header" ]; then
            http_code="$(curl -sS -X "$method" \
                "${supabase_url}${path}" \
                -H "apikey: ${supabase_anon_key}" \
                -H "Authorization: Bearer ${supabase_anon_key}" \
                -H "Prefer: ${prefer_header}" \
                -o "$response_file" \
                -w "%{http_code}")"
        else
            http_code="$(curl -sS -X "$method" \
                "${supabase_url}${path}" \
                -H "apikey: ${supabase_anon_key}" \
                -H "Authorization: Bearer ${supabase_anon_key}" \
                -o "$response_file" \
                -w "%{http_code}")"
        fi
    fi

    if [ "$http_code" -ge 200 ] && [ "$http_code" -lt 300 ]; then
        return 0
    fi

    body_preview="$(head -c 280 "$response_file" 2>/dev/null | tr '\n' ' ')"
    caddie cli:red "Error: Supabase request failed (${method} ${path}) [HTTP ${http_code}]"
    if [ -n "$body_preview" ]; then
        caddie cli:indent "$body_preview"
    fi
    return 1
}

function caddie_ledger_supabase_storage_upload() {
    local supabase_url="$1"
    local supabase_anon_key="$2"
    local bucket="$3"
    local object_key="$4"
    local source_file="$5"
    local response_file="$6"
    local encoded_object_key=""
    local http_code=""
    local body_preview=""

    encoded_object_key="$(caddie_ledger_url_encode "$object_key")"
    http_code="$(curl -sS -X POST \
        "${supabase_url}/storage/v1/object/${bucket}/${encoded_object_key}" \
        -H "apikey: ${supabase_anon_key}" \
        -H "Authorization: Bearer ${supabase_anon_key}" \
        -H "x-upsert: true" \
        -H "Content-Type: application/octet-stream" \
        --data-binary "@${source_file}" \
        -o "$response_file" \
        -w "%{http_code}")"

    if [ "$http_code" -ge 200 ] && [ "$http_code" -lt 300 ]; then
        return 0
    fi

    body_preview="$(head -c 280 "$response_file" 2>/dev/null | tr '\n' ' ')"
    caddie cli:red "Error: Supabase storage upload failed (${bucket}/${object_key}) [HTTP ${http_code}]"
    if [ -n "$body_preview" ]; then
        caddie cli:indent "$body_preview"
    fi
    return 1
}

function caddie_ledger_supabase_storage_download() {
    local supabase_url="$1"
    local supabase_anon_key="$2"
    local bucket="$3"
    local object_key="$4"
    local destination_file="$5"
    local encoded_object_key=""
    local http_code=""
    local body_preview=""

    encoded_object_key="$(caddie_ledger_url_encode "$object_key")"
    http_code="$(curl -sS -X GET \
        "${supabase_url}/storage/v1/object/${bucket}/${encoded_object_key}" \
        -H "apikey: ${supabase_anon_key}" \
        -H "Authorization: Bearer ${supabase_anon_key}" \
        -o "$destination_file" \
        -w "%{http_code}")"

    if [ "$http_code" -ge 200 ] && [ "$http_code" -lt 300 ]; then
        return 0
    fi

    body_preview="$(head -c 280 "$destination_file" 2>/dev/null | tr '\n' ' ')"
    rm -f "$destination_file"
    caddie cli:red "Error: Supabase storage download failed (${bucket}/${object_key}) [HTTP ${http_code}]"
    if [ -n "$body_preview" ]; then
        caddie cli:indent "$body_preview"
    fi
    return 1
}

function caddie_ledger_supabase_storage_delete() {
    local supabase_url="$1"
    local supabase_anon_key="$2"
    local bucket="$3"
    local object_key="$4"
    local response_file="$5"
    local encoded_object_key=""
    local http_code=""
    local body_preview=""

    encoded_object_key="$(caddie_ledger_url_encode "$object_key")"
    http_code="$(curl -sS -X DELETE \
        "${supabase_url}/storage/v1/object/${bucket}/${encoded_object_key}" \
        -H "apikey: ${supabase_anon_key}" \
        -H "Authorization: Bearer ${supabase_anon_key}" \
        -o "$response_file" \
        -w "%{http_code}")"

    if [ "$http_code" -ge 200 ] && [ "$http_code" -lt 300 ]; then
        return 0
    fi

    body_preview="$(head -c 280 "$response_file" 2>/dev/null | tr '\n' ' ')"
    caddie cli:red "Error: Supabase storage delete failed (${bucket}/${object_key}) [HTTP ${http_code}]"
    if [ -n "$body_preview" ]; then
        caddie cli:indent "$body_preview"
    fi
    return 1
}

