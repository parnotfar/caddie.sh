    fi

    if ! caddie_ledger_schema_db_file_write "$(caddie_ledger_schema_db_port_file)" "$value" "port"; then
        return 1
    fi

    caddie cli:check "Ledger schema DB port set"
    caddie cli:indent "port: $value"
    return 0
}

function caddie_ledger_schema_db_port_get() {
    caddie cli:green "Ledger schema DB port: $(caddie_ledger_schema_db_port_get_value)"
    return 0
}

function caddie_ledger_schema_db_port_unset() {
    if ! caddie_ledger_schema_db_file_clear "$(caddie_ledger_schema_db_port_file)" "port override"; then
        return 1
    fi
    caddie cli:indent "default port: 5432"
    return 0
