}

function caddie_ledger_auth_get() {
    local config_file=""
    local supabase_url=""
    local supabase_anon_key=""
    local project_id=""
    local snapshots_bucket=""
    local transcripts_bucket=""
    local artifacts_bucket=""
    local masked_key=""

    config_file="$(caddie_ledger_config_file)"
    if [ ! -f "$config_file" ]; then
        caddie cli:yellow "No ledger Supabase config found"
        caddie cli:thought "Set one with: caddie ledger:auth:set <supabase_url> <supabase_anon_key> <project_id>"
        return 0
    fi

    supabase_url="$(caddie_ledger_config_read_value "supabase_url")"
    supabase_anon_key="$(caddie_ledger_config_read_value "supabase_anon_key")"
    project_id="$(caddie_ledger_config_read_value "project_id")"
    snapshots_bucket="$(caddie_ledger_config_bucket_value "snapshots_bucket" "snapshots")"
    transcripts_bucket="$(caddie_ledger_config_bucket_value "transcripts_bucket" "transcripts")"
    artifacts_bucket="$(caddie_ledger_config_bucket_value "artifacts_bucket" "artifacts")"

    if [ -n "$supabase_anon_key" ]; then
        masked_key="${supabase_anon_key:0:8}...(${#supabase_anon_key} chars)"
    else
        masked_key="(not set)"
    fi

    caddie cli:title "Ledger Supabase Auth"
    caddie cli:indent "config: $config_file"
    caddie cli:indent "supabase_url: ${supabase_url:-<empty>}"
    caddie cli:indent "supabase_anon_key: $masked_key"
    caddie cli:indent "project_id: ${project_id:-<empty>}"
    caddie cli:indent "snapshots_bucket: $snapshots_bucket"
    caddie cli:indent "transcripts_bucket: $transcripts_bucket"
    caddie cli:indent "artifacts_bucket: $artifacts_bucket"
    return 0
}

function caddie_ledger_auth_unset() {
    local config_file=""

    config_file="$(caddie_ledger_config_file)"
    if [ ! -f "$config_file" ]; then
        caddie cli:yellow "No ledger Supabase config was set"
        return 0
    fi

    if ! rm -f "$config_file"; then
        caddie cli:red "Error: Unable to remove ledger Supabase config"
        return 1
    fi

    caddie cli:check "Ledger Supabase auth config removed"
    return 0
}

function caddie_ledger_checkpoint_id_latest() {
    local repo_root="$1"
    local active_checkpoint=""
    local latest_manifest=""
    local checkpoint_id=""

    active_checkpoint="$(caddie_ledger_active_checkpoint_id "$repo_root")"
    if [ -n "$active_checkpoint" ]; then
        printf '%s' "$active_checkpoint"
        return 0
    fi

    latest_manifest="$(find "$(caddie_ledger_sessions_dir "$repo_root")" -type f -name manifest.json 2>/dev/null | sort | tail -n 1)"
    if [ -z "$latest_manifest" ]; then
        printf '%s' ""
        return 0
    fi

    checkpoint_id="$(caddie_ledger_json_read_string "$latest_manifest" "checkpoint_id")"
    printf '%s' "$checkpoint_id"
    return 0
}

function caddie_ledger_sync_resolve_targets() {
    local repo_root="$1"
    local target="$2"
    local checkpoint_id=""
    local checkpoint_dir=""

    if [ -z "$target" ] || [ "$target" = "latest" ]; then
        checkpoint_id="$(caddie_ledger_checkpoint_id_latest "$repo_root")"
        if [ -n "$checkpoint_id" ]; then
            printf '%s\n' "$checkpoint_id"
        fi
        return 0
    fi

    if [ "$target" = "all" ]; then
        find "$(caddie_ledger_sessions_dir "$repo_root")" -type f -name manifest.json 2>/dev/null \
            | sort \
            | while IFS= read -r manifest_path; do
                caddie_ledger_json_read_string "$manifest_path" "checkpoint_id"
                printf '\n'
            done \
            | sed '/^[[:space:]]*$/d'
        return 0
    fi

    checkpoint_dir="$(caddie_ledger_find_checkpoint_dir "$repo_root" "$target")"
    if [ -n "$checkpoint_dir" ]; then
        printf '%s\n' "$target"
        return 0
    fi

    caddie cli:red "Error: Checkpoint not found: $target"
    return 1
}

function caddie_ledger_sync_push_one() {
    local repo_root="$1"
    local checkpoint_id="$2"
    local supabase_url="$3"
    local supabase_anon_key="$4"
    local project_id="$5"
    local snapshots_bucket="$6"
    local transcripts_bucket="$7"
    local artifacts_bucket="$8"
    local checkpoint_dir=""
    local manifest_path=""
    local snapshot_path=""
    local transcripts_path=""
    local artifacts_dir=""
    local response_file=""
    local project_name=""
    local created_at=""
    local message=""
    local session_id=""
    local branch=""
    local git_sha=""
    local snapshot_sha=""
    local verification_json=""
    local provenance_json=""
    local snapshot_object=""
    local transcript_object=""
    local escaped_project_id=""
    local escaped_project_name=""
    local escaped_repo_root=""
    local escaped_message=""
    local escaped_session_id=""
    local escaped_checkpoint_id=""
    local escaped_snapshot_object=""
    local escaped_transcript_object=""
    local escaped_branch=""
    local escaped_git_sha=""
    local escaped_fingerprint=""
    local payload=""
    local artifact_path=""
    local artifact_name=""
    local artifact_object=""
    local artifact_kind=""
    local artifact_index=0
    local artifact_tmp_zip=""
    local artifact_upload_source=""

    checkpoint_dir="$(caddie_ledger_find_checkpoint_dir "$repo_root" "$checkpoint_id")"
    if [ -z "$checkpoint_dir" ]; then
        caddie cli:red "Error: Unable to locate checkpoint directory for $checkpoint_id"
        return 1
    fi

    manifest_path="${checkpoint_dir}/manifest.json"
    snapshot_path="${checkpoint_dir}/snapshot.zip"
    transcripts_path="${checkpoint_dir}/transcripts/checkpoint.md"
    artifacts_dir="${checkpoint_dir}/artifacts"
    response_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-sync.XXXXXX")"

    if [ ! -f "$manifest_path" ] || [ ! -f "$snapshot_path" ]; then
        rm -f "$response_file"
        caddie cli:red "Error: Checkpoint capsule is incomplete for $checkpoint_id"
        return 1
    fi

    project_name="$(basename "$repo_root")"
    created_at="$(caddie_ledger_json_query "$manifest_path" ".created_at")"
    message="$(caddie_ledger_json_query "$manifest_path" ".message")"
    session_id="$(caddie_ledger_json_query "$manifest_path" ".session_id")"
    branch="$(caddie_ledger_json_query "$manifest_path" ".repo.branch")"
    git_sha="$(caddie_ledger_json_query "$manifest_path" ".repo.git_sha")"
    snapshot_sha="$(caddie_ledger_json_query "$manifest_path" ".snapshot.sha256")"
    verification_json="$(caddie_ledger_json_query "$manifest_path" ".verification")"
    if [ -z "$verification_json" ]; then
        verification_json="{}"
    fi

    provenance_json="$(cat <<EOF
{"repo_root":"$(caddie_ledger_json_escape "$repo_root")","branch":"$(caddie_ledger_json_escape "$branch")","git_sha":"$(caddie_ledger_json_escape "$git_sha")","local_checkpoint":"$(caddie_ledger_json_escape "$checkpoint_id")"}
EOF
)"

    snapshot_object="${project_id}/${session_id}/${checkpoint_id}/snapshot.zip"
    transcript_object="${project_id}/${session_id}/${checkpoint_id}/checkpoint.md"

    if ! caddie_ledger_supabase_storage_upload \
        "$supabase_url" \
        "$supabase_anon_key" \
        "$snapshots_bucket" \
        "$snapshot_object" \
        "$snapshot_path" \
        "$response_file"; then
        rm -f "$response_file"
        return 1
    fi

    if [ -f "$transcripts_path" ]; then
        caddie_ledger_supabase_storage_upload \
            "$supabase_url" \
            "$supabase_anon_key" \
            "$transcripts_bucket" \
            "$transcript_object" \
            "$transcripts_path" \
            "$response_file" >/dev/null 2>&1 || true
    fi

    escaped_project_id="$(caddie_ledger_json_escape "$project_id")"
    escaped_project_name="$(caddie_ledger_json_escape "$project_name")"
    escaped_repo_root="$(caddie_ledger_json_escape "$repo_root")"
    escaped_message="$(caddie_ledger_json_escape "$message")"
    escaped_session_id="$(caddie_ledger_json_escape "$session_id")"
    escaped_checkpoint_id="$(caddie_ledger_json_escape "$checkpoint_id")"
    escaped_snapshot_object="$(caddie_ledger_json_escape "$snapshot_object")"
    escaped_transcript_object="$(caddie_ledger_json_escape "$transcript_object")"
    escaped_branch="$(caddie_ledger_json_escape "$branch")"
    escaped_git_sha="$(caddie_ledger_json_escape "$git_sha")"
    escaped_fingerprint="$(caddie_ledger_json_escape "${snapshot_sha:-$checkpoint_id}")"

    payload="$(cat <<EOF
[{"id":"${escaped_project_id}","name":"${escaped_project_name}","repo_root":"${escaped_repo_root}","created_at":"${created_at}"}]
EOF
)"
    if ! caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/projects?on_conflict=id" \
        "$payload" \
        "resolution=merge-duplicates,return=minimal" \
        "$response_file"; then
        rm -f "$response_file"
        return 1
    fi

    payload="$(cat <<EOF
[{"id":"${escaped_session_id}","project_id":"${escaped_project_id}","agent":"ledger","started_at":"${created_at}","labels":{}}]
EOF
)"
    if ! caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/sessions?on_conflict=id" \
        "$payload" \
        "resolution=merge-duplicates,return=minimal" \
        "$response_file"; then
        rm -f "$response_file"
        return 1
    fi

    payload="$(cat <<EOF
[{"id":"${escaped_checkpoint_id}","session_id":"${escaped_session_id}","created_at":"${created_at}","message":"${escaped_message}","snapshot_object":"${escaped_snapshot_object}","provenance":${provenance_json},"verification":${verification_json},"fingerprint":"${escaped_fingerprint}"}]
EOF
)"
    if ! caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/checkpoints?on_conflict=id" \
        "$payload" \
        "resolution=merge-duplicates,return=minimal" \
        "$response_file"; then
        rm -f "$response_file"
        return 1
    fi

    if [ -d "$artifacts_dir" ]; then
        for artifact_path in "$artifacts_dir"/*; do
            if [ ! -e "$artifact_path" ]; then
                continue
            fi

            artifact_name="$(basename "$artifact_path")"
            if [ "$artifact_name" = "index.jsonl" ]; then
                continue
            fi

            artifact_upload_source="$artifact_path"
            artifact_kind="file"
            artifact_tmp_zip=""

            if [ -d "$artifact_path" ]; then
                artifact_tmp_zip="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-artifact.XXXXXX.zip")"
                if ! (cd "$artifacts_dir" && zip -q -r "$artifact_tmp_zip" "$artifact_name"); then
                    rm -f "$artifact_tmp_zip"
                    continue
                fi
                artifact_upload_source="$artifact_tmp_zip"
                artifact_kind="directory_zip"
                artifact_name="${artifact_name}.zip"
            fi

            artifact_object="${project_id}/${session_id}/${checkpoint_id}/${artifact_name}"
            if caddie_ledger_supabase_storage_upload \
                "$supabase_url" \
                "$supabase_anon_key" \
                "$artifacts_bucket" \
                "$artifact_object" \
                "$artifact_upload_source" \
                "$response_file"; then
                artifact_index=$((artifact_index + 1))
                payload="$(cat <<EOF
[{"id":"${escaped_checkpoint_id}-artifact-${artifact_index}","checkpoint_id":"${escaped_checkpoint_id}","kind":"${artifact_kind}","object_key":"$(caddie_ledger_json_escape "$artifact_object")","meta":{"source":"$(caddie_ledger_json_escape "$artifact_name")"}}]
EOF
)"
                caddie_ledger_supabase_json_request \
                    "$supabase_url" \
                    "$supabase_anon_key" \
                    "POST" \
                    "/rest/v1/artifacts?on_conflict=id" \
                    "$payload" \
                    "resolution=merge-duplicates,return=minimal" \
                    "$response_file" >/dev/null 2>&1 || true
            fi

            if [ -n "$artifact_tmp_zip" ]; then
                rm -f "$artifact_tmp_zip"
            fi
        done
    fi

    payload="$(cat <<EOF
[{"session_id":"${escaped_session_id}","ts":"$(caddie_ledger_timestamp_utc)","type":"sync_push","payload":{"checkpoint_id":"${escaped_checkpoint_id}","snapshot_object":"${escaped_snapshot_object}","transcript_object":"${escaped_transcript_object}","branch":"${escaped_branch}","git_sha":"${escaped_git_sha}"}}]
EOF
)"
    caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/events" \
        "$payload" \
        "return=minimal" \
        "$response_file" >/dev/null 2>&1 || true

    rm -f "$response_file"
    return 0
}

function caddie_ledger_sync_push() {
    local target="$1"
    local repo_root=""
    local config=""
    local supabase_url=""
    local supabase_anon_key=""
    local project_id=""
    local snapshots_bucket=""
    local transcripts_bucket=""
    local artifacts_bucket=""
    local checkpoint_id=""
    local targets=""
    local pushed_count=0
    local failed_count=0

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    if ! command -v curl >/dev/null 2>&1; then
        caddie cli:red "Error: 'curl' is required for ledger sync"
        return 1
    fi

    config="$(caddie_ledger_supabase_config_resolve)" || return 1
    supabase_url="$(printf '%s' "$config" | cut -d'|' -f1)"
    supabase_anon_key="$(printf '%s' "$config" | cut -d'|' -f2)"
    project_id="$(printf '%s' "$config" | cut -d'|' -f3)"
    snapshots_bucket="$(printf '%s' "$config" | cut -d'|' -f4)"
    transcripts_bucket="$(printf '%s' "$config" | cut -d'|' -f5)"
    artifacts_bucket="$(printf '%s' "$config" | cut -d'|' -f6)"

    targets="$(caddie_ledger_sync_resolve_targets "$repo_root" "$target")" || return 1

    while IFS= read -r checkpoint_id; do
        if [ -z "$checkpoint_id" ]; then
            continue
        fi

        caddie cli:indent "sync:push -> $checkpoint_id"
        if caddie_ledger_sync_push_one \
            "$repo_root" \
            "$checkpoint_id" \
            "$supabase_url" \
            "$supabase_anon_key" \
            "$project_id" \
            "$snapshots_bucket" \
            "$transcripts_bucket" \
            "$artifacts_bucket"; then
            pushed_count=$((pushed_count + 1))
        else
            failed_count=$((failed_count + 1))
        fi
    done <<< "$targets"

    if [ "$pushed_count" -eq 0 ] && [ "$failed_count" -eq 0 ]; then
        caddie cli:yellow "No checkpoints to push"
        return 0
    fi

    if [ "$failed_count" -gt 0 ]; then
        caddie cli:red "Ledger sync push completed with failures"
        caddie cli:indent "pushed: $pushed_count"
        caddie cli:indent "failed: $failed_count"
        return 1
    fi

    caddie cli:check "Ledger sync push completed"
    caddie cli:indent "pushed: $pushed_count"
    return 0
}

function caddie_ledger_sync_pull() {
    local checkpoint_id="$1"
    local repo_root=""
    local config=""
    local supabase_url=""
    local supabase_anon_key=""
    local project_id=""
    local snapshots_bucket=""
    local transcripts_bucket=""
    local artifacts_bucket=""
    local response_file=""
    local artifact_response_file=""
    local encoded_checkpoint_id=""
    local remote_count=0
    local remote_session_id=""
    local remote_created_at=""
    local remote_message=""
    local remote_snapshot_object=""
    local remote_verification=""
    local remote_provenance=""
    local local_session_id=""
    local local_checkpoint_id=""
    local session_dir=""
    local checkpoint_dir=""
    local snapshot_path=""
    local transcript_path=""
    local manifests_dir=""
    local restore_dir=""
    local checkpoint_count=0
    local session_file=""
    local now_ts=""
    local artifact_object=""
    local artifact_name=""
    local artifact_local_path=""
    local artifact_counter=0

    if [ -z "$checkpoint_id" ]; then
        caddie cli:red "Error: Please provide a checkpoint id"
        caddie cli:usage "caddie ledger:sync:pull <checkpoint_id>"
        return 1
    fi

    if ! command -v curl >/dev/null 2>&1; then
        caddie cli:red "Error: 'curl' is required for ledger sync"
        return 1
    fi

    repo_root="$(caddie_ledger_repo_root)"
    if [ ! -f "$(caddie_ledger_project_file "$repo_root")" ]; then
        caddie_ledger_project_init >/dev/null 2>&1 || true
    fi
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    config="$(caddie_ledger_supabase_config_resolve)" || return 1
    supabase_url="$(printf '%s' "$config" | cut -d'|' -f1)"
    supabase_anon_key="$(printf '%s' "$config" | cut -d'|' -f2)"
    project_id="$(printf '%s' "$config" | cut -d'|' -f3)"
    snapshots_bucket="$(printf '%s' "$config" | cut -d'|' -f4)"
    transcripts_bucket="$(printf '%s' "$config" | cut -d'|' -f5)"
    artifacts_bucket="$(printf '%s' "$config" | cut -d'|' -f6)"
    response_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-sync-pull.XXXXXX")"

    encoded_checkpoint_id="$(caddie_ledger_url_encode "$checkpoint_id")"
    if ! caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "GET" \
        "/rest/v1/checkpoints?id=eq.${encoded_checkpoint_id}&select=id,session_id,created_at,message,snapshot_object,verification,provenance,fingerprint" \
        "" \
        "" \
        "$response_file"; then
        rm -f "$response_file"
        return 1
    fi

    remote_count="$(caddie_ledger_json_array_length "$response_file")"
    if [ "$remote_count" = "0" ]; then
        rm -f "$response_file"
        caddie cli:red "Error: Remote checkpoint not found: $checkpoint_id"
        return 1
    fi

    remote_session_id="$(caddie_ledger_json_array_first_field "$response_file" "session_id")"
    remote_created_at="$(caddie_ledger_json_array_first_field "$response_file" "created_at")"
    remote_message="$(caddie_ledger_json_array_first_field "$response_file" "message")"
    remote_snapshot_object="$(caddie_ledger_json_array_first_field "$response_file" "snapshot_object")"
    remote_verification="$(caddie_ledger_json_array_first_field "$response_file" "verification")"
    remote_provenance="$(caddie_ledger_json_array_first_field "$response_file" "provenance")"
    rm -f "$response_file"

    if [ -z "$remote_snapshot_object" ]; then
        caddie cli:red "Error: Remote checkpoint has no snapshot_object"
        return 1
    fi

    local_session_id="sync-${remote_session_id}"
    local_session_id="$(printf '%s' "$local_session_id" | sed 's/[^a-zA-Z0-9._-]/-/g')"
    if [ -z "$local_session_id" ]; then
        local_session_id="sync-session"
    fi

    local_checkpoint_id="$checkpoint_id"
    checkpoint_dir="$(caddie_ledger_sessions_dir "$repo_root")/${local_session_id}/checkpoints/${local_checkpoint_id}"
    if [ -d "$checkpoint_dir" ]; then
        now_ts="$(date -u +"%Y%m%dT%H%M%SZ")"
        local_checkpoint_id="${local_checkpoint_id}-pull-${now_ts}"
    fi

    session_dir="$(caddie_ledger_sessions_dir "$repo_root")/${local_session_id}"
    checkpoint_dir="${session_dir}/checkpoints/${local_checkpoint_id}"
    manifests_dir="${checkpoint_dir}"
    snapshot_path="${checkpoint_dir}/snapshot.zip"
    transcript_path="${checkpoint_dir}/transcripts/checkpoint.md"
    session_file="${session_dir}/session.json"

    if ! mkdir -p "${checkpoint_dir}/transcripts" "${checkpoint_dir}/artifacts" "${checkpoint_dir}/verification"; then
        caddie cli:red "Error: Unable to prepare local checkpoint directory"
        return 1
    fi
    : > "${checkpoint_dir}/artifacts/index.jsonl"
    : > "${checkpoint_dir}/verification/verify.log"
    : > "${checkpoint_dir}/verification/files.sha256"

    if ! caddie_ledger_supabase_storage_download \
        "$supabase_url" \
        "$supabase_anon_key" \
        "$snapshots_bucket" \
        "$remote_snapshot_object" \
        "$snapshot_path"; then
        return 1
    fi

    caddie_ledger_supabase_storage_download \
        "$supabase_url" \
        "$supabase_anon_key" \
        "$transcripts_bucket" \
        "${project_id}/${remote_session_id}/${checkpoint_id}/checkpoint.md" \
        "$transcript_path" >/dev/null 2>&1 || true
    if [ ! -f "$transcript_path" ]; then
        cat > "$transcript_path" <<EOF
# Pulled Checkpoint Transcript

- checkpoint_id: ${checkpoint_id}
- remote_session_id: ${remote_session_id}
- message: ${remote_message}
EOF
    fi

    artifact_response_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-sync-pull-artifacts.XXXXXX")"
    if caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "GET" \
        "/rest/v1/artifacts?checkpoint_id=eq.${encoded_checkpoint_id}&select=object_key" \
        "" \
        "" \
        "$artifact_response_file"; then
        while IFS= read -r artifact_object; do
            if [ -z "$artifact_object" ]; then
                continue
            fi

            artifact_counter=$((artifact_counter + 1))
            artifact_name="$(basename "$artifact_object")"
            if [ -z "$artifact_name" ]; then
                artifact_name="artifact-${artifact_counter}"
            fi

            artifact_local_path="${checkpoint_dir}/artifacts/${artifact_name}"
            if [ -e "$artifact_local_path" ]; then
                artifact_local_path="${checkpoint_dir}/artifacts/${artifact_counter}-${artifact_name}"
            fi

            if caddie_ledger_supabase_storage_download \
                "$supabase_url" \
                "$supabase_anon_key" \
                "$artifacts_bucket" \
                "$artifact_object" \
                "$artifact_local_path"; then
                printf '{"added_at":"%s","source_path":"%s","stored_path":"%s"}\n' \
                    "$(caddie_ledger_timestamp_utc)" \
                    "$(caddie_ledger_json_escape "$artifact_object")" \
                    "$(caddie_ledger_json_escape "artifacts/$(basename "$artifact_local_path")")" >> "${checkpoint_dir}/artifacts/index.jsonl"
            fi
        done < <(caddie_ledger_json_array_field_lines "$artifact_response_file" "object_key")
    fi
    rm -f "$artifact_response_file"

    if [ -z "$remote_created_at" ]; then
        remote_created_at="$(caddie_ledger_timestamp_utc)"
    fi
    if [ -z "$remote_message" ]; then
        remote_message="pulled checkpoint ${checkpoint_id}"
    fi
    if [ -z "$remote_verification" ]; then
        remote_verification='{"status":"unknown","exit_code":0,"log_path":"verification/verify.log"}'
    fi
    if [ -z "$remote_provenance" ]; then
        remote_provenance="{}"
    fi

    if ! caddie_ledger_write_manifest \
        "${manifests_dir}/manifest.json" \
        "$repo_root" \
        "$local_session_id" \
        "$local_checkpoint_id" \
        "$remote_created_at" \
        "$remote_message" \
        "$(printf '%s' "$remote_provenance" | sed -n 's/.*"branch":"\([^"]*\)".*/\1/p')" \
        "$(printf '%s' "$remote_provenance" | sed -n 's/.*"git_sha":"\([^"]*\)".*/\1/p')" \
        "0" \
        "0" \
        "none" \
        "$(caddie_ledger_hash_file "$snapshot_path")" \
        "supabase pull" \
        "0" \
        "pulled" \
        "$artifact_counter"; then
        caddie cli:red "Error: Unable to write pulled checkpoint manifest"
        return 1
    fi

    checkpoint_count="$(find "${session_dir}/checkpoints" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d '[:space:]')"
    if [ -z "$checkpoint_count" ]; then
        checkpoint_count=1
    fi
    caddie_ledger_write_session_json \
        "$session_file" \
        "$local_session_id" \
        "supabase" \
        "$remote_created_at" \
        "$checkpoint_count" \
        "$local_checkpoint_id" \
        "" >/dev/null 2>&1 || true

    printf '%s\n' "$local_session_id" > "$(caddie_ledger_current_session_file "$repo_root")"
    printf '%s\n' "$local_checkpoint_id" > "$(caddie_ledger_current_checkpoint_file "$repo_root")"

    restore_dir="$(caddie_ledger_dir "$repo_root")/restores/${local_checkpoint_id}-pull-$(date -u +"%Y%m%dT%H%M%SZ")"
    caddie_ledger_restore "$local_checkpoint_id" "$restore_dir" >/dev/null 2>&1 || true

    caddie cli:check "Ledger sync pull completed"
    caddie cli:indent "remote checkpoint: $checkpoint_id"
    caddie cli:indent "local checkpoint: $local_checkpoint_id"
    caddie cli:indent "snapshot object: $remote_snapshot_object"
    caddie cli:indent "restored to: $restore_dir"
    caddie cli:indent "artifacts pulled: $artifact_counter"
    return 0
}

function caddie_ledger_sync_check() {
    local repo_root=""
    local config=""
    local supabase_url=""
    local supabase_anon_key=""
    local project_id=""
    local snapshots_bucket=""
    local transcripts_bucket=""
    local artifacts_bucket=""
    local response_file=""
    local storage_response_file=""
    local bucket_list=""
    local bucket_name=""
    local table_name=""
    local checks_total=0
    local checks_failed=0
    local probe_stamp=""
    local probe_project_name=""
    local probe_created_at=""
    local probe_session_id=""
    local probe_checkpoint_id=""
    local probe_artifact_id=""
    local probe_event_type="sync_check"
    local probe_object_key=""
    local probe_file=""
    local payload=""
    local created_session=0
    local created_checkpoint=0
    local created_artifact=0
    local created_event=0
    local cleanup_response_file=""
    local enc_session_id=""
    local enc_checkpoint_id=""
    local enc_artifact_id=""

    if ! command -v curl >/dev/null 2>&1; then
        caddie cli:red "Error: 'curl' is required for ledger sync checks"
        return 1
    fi

    repo_root="$(caddie_ledger_repo_root)"
    config="$(caddie_ledger_supabase_config_resolve)" || return 1
    supabase_url="$(printf '%s' "$config" | cut -d'|' -f1)"
    supabase_anon_key="$(printf '%s' "$config" | cut -d'|' -f2)"
    project_id="$(printf '%s' "$config" | cut -d'|' -f3)"
    snapshots_bucket="$(printf '%s' "$config" | cut -d'|' -f4)"
    transcripts_bucket="$(printf '%s' "$config" | cut -d'|' -f5)"
    artifacts_bucket="$(printf '%s' "$config" | cut -d'|' -f6)"

    response_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-sync-check.XXXXXX")"
    storage_response_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-sync-check-storage.XXXXXX")"
    cleanup_response_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-sync-check-cleanup.XXXXXX")"
    probe_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-sync-check-probe.XXXXXX")"
    printf '%s\n' "ledger sync check probe" > "$probe_file"

    caddie cli:title "Ledger Sync Check"
    caddie cli:indent "project_id: $project_id"
    caddie cli:indent "supabase_url: $supabase_url"
    caddie cli:indent "buckets: snapshots=$snapshots_bucket transcripts=$transcripts_bucket artifacts=$artifacts_bucket"

    checks_total=$((checks_total + 1))
    if caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "GET" \
        "/auth/v1/health" \
        "" \
        "" \
        "$response_file"; then
        caddie cli:check "Supabase endpoint reachable"
    else
        checks_failed=$((checks_failed + 1))
    fi

    checks_total=$((checks_total + 1))
    if caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "GET" \
        "/storage/v1/bucket" \
        "" \
        "" \
        "$response_file"; then
        bucket_list="$(caddie_ledger_json_array_field_lines "$response_file" "name")"
        caddie cli:check "Storage bucket listing is accessible"
    else
        checks_failed=$((checks_failed + 1))
        bucket_list=""
    fi

    for bucket_name in "$snapshots_bucket" "$transcripts_bucket" "$artifacts_bucket"; do
        checks_total=$((checks_total + 1))
        if printf '%s\n' "$bucket_list" | grep -Fxq "$bucket_name"; then
            caddie cli:check "Bucket exists: $bucket_name"
        else
            caddie cli:red "Bucket missing or not visible: $bucket_name"
            checks_failed=$((checks_failed + 1))
        fi
    done

    for table_name in projects sessions checkpoints artifacts events; do
        checks_total=$((checks_total + 1))
        if caddie_ledger_supabase_json_request \
            "$supabase_url" \
            "$supabase_anon_key" \
            "GET" \
            "/rest/v1/${table_name}?select=*&limit=1" \
            "" \
            "" \
            "$response_file"; then
            caddie cli:check "Table select ok: $table_name"
        else
            caddie cli:red "Table select failed: $table_name"
            checks_failed=$((checks_failed + 1))
        fi
    done

    probe_stamp="$(date -u +"%Y%m%dT%H%M%SZ")-$$"
    probe_project_name="$(basename "$repo_root")"
    probe_created_at="$(caddie_ledger_timestamp_utc)"
    probe_session_id="$(printf '%s' "sync-check-session-${probe_stamp}" | sed 's/[^a-zA-Z0-9._-]/-/g')"
    probe_checkpoint_id="$(printf '%s' "sync-check-checkpoint-${probe_stamp}" | sed 's/[^a-zA-Z0-9._-]/-/g')"
    probe_artifact_id="$(printf '%s' "sync-check-artifact-${probe_stamp}" | sed 's/[^a-zA-Z0-9._-]/-/g')"
    probe_object_key="${project_id}/sync-check/${probe_stamp}.txt"

    payload="$(cat <<EOF
[{"id":"$(caddie_ledger_json_escape "$project_id")","name":"$(caddie_ledger_json_escape "$probe_project_name")","repo_root":"$(caddie_ledger_json_escape "$repo_root")","created_at":"$probe_created_at"}]
EOF
)"
    checks_total=$((checks_total + 1))
    if caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/projects?on_conflict=id" \
        "$payload" \
        "resolution=merge-duplicates,return=minimal" \
        "$response_file"; then
        caddie cli:check "Table write ok: projects (upsert)"
    else
        caddie cli:red "Table write failed: projects (upsert)"
        checks_failed=$((checks_failed + 1))
    fi

    payload="$(cat <<EOF
[{"id":"$(caddie_ledger_json_escape "$probe_session_id")","project_id":"$(caddie_ledger_json_escape "$project_id")","agent":"ledger-sync-check","started_at":"$probe_created_at","labels":{"sync_check":true}}]
EOF
)"
    checks_total=$((checks_total + 1))
    if caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/sessions?on_conflict=id" \
        "$payload" \
        "resolution=merge-duplicates,return=minimal" \
        "$response_file"; then
        created_session=1
        caddie cli:check "Table write ok: sessions (upsert)"
    else
        caddie cli:red "Table write failed: sessions (upsert)"
        checks_failed=$((checks_failed + 1))
    fi

    payload="$(cat <<EOF
[{"id":"$(caddie_ledger_json_escape "$probe_checkpoint_id")","session_id":"$(caddie_ledger_json_escape "$probe_session_id")","created_at":"$probe_created_at","message":"sync check probe","snapshot_object":"$(caddie_ledger_json_escape "$probe_object_key")","provenance":{},"verification":{},"fingerprint":"$(caddie_ledger_json_escape "$probe_checkpoint_id")"}]
EOF
)"
    checks_total=$((checks_total + 1))
    if caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/checkpoints?on_conflict=id" \
        "$payload" \
        "resolution=merge-duplicates,return=minimal" \
        "$response_file"; then
        created_checkpoint=1
        caddie cli:check "Table write ok: checkpoints (upsert)"
    else
        caddie cli:red "Table write failed: checkpoints (upsert)"
        checks_failed=$((checks_failed + 1))
    fi

    payload="$(cat <<EOF
[{"id":"$(caddie_ledger_json_escape "$probe_artifact_id")","checkpoint_id":"$(caddie_ledger_json_escape "$probe_checkpoint_id")","kind":"sync_check","object_key":"$(caddie_ledger_json_escape "$probe_object_key")","meta":{"probe":true}}]
EOF
)"
    checks_total=$((checks_total + 1))
    if caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/artifacts?on_conflict=id" \
        "$payload" \
        "resolution=merge-duplicates,return=minimal" \
        "$response_file"; then
        created_artifact=1
        caddie cli:check "Table write ok: artifacts (upsert)"
    else
        caddie cli:red "Table write failed: artifacts (upsert)"
        checks_failed=$((checks_failed + 1))
    fi

    payload="$(cat <<EOF
[{"session_id":"$(caddie_ledger_json_escape "$probe_session_id")","ts":"$probe_created_at","type":"$probe_event_type","payload":{"checkpoint_id":"$(caddie_ledger_json_escape "$probe_checkpoint_id")","probe":true}}]
EOF
)"
    checks_total=$((checks_total + 1))
    if caddie_ledger_supabase_json_request \
        "$supabase_url" \
        "$supabase_anon_key" \
        "POST" \
        "/rest/v1/events" \
        "$payload" \
        "return=minimal" \
        "$response_file"; then
        created_event=1
        caddie cli:check "Table write ok: events (insert)"
    else
        caddie cli:red "Table write failed: events (insert)"
        checks_failed=$((checks_failed + 1))
    fi

    checks_total=$((checks_total + 1))
    if caddie_ledger_supabase_storage_upload \
        "$supabase_url" \
        "$supabase_anon_key" \
        "$snapshots_bucket" \
        "$probe_object_key" \
        "$probe_file" \
        "$storage_response_file"; then
        caddie cli:check "Storage write ok: ${snapshots_bucket}/${probe_object_key}"

        checks_total=$((checks_total + 1))
        if caddie_ledger_supabase_storage_delete \
            "$supabase_url" \
            "$supabase_anon_key" \
            "$snapshots_bucket" \
            "$probe_object_key" \
            "$storage_response_file"; then
            caddie cli:check "Storage delete ok: ${snapshots_bucket}/${probe_object_key}"
        else
            caddie cli:red "Storage delete failed for probe object"
            checks_failed=$((checks_failed + 1))
        fi
    else
        caddie cli:red "Storage write failed for probe object"
        checks_failed=$((checks_failed + 1))
    fi

    enc_session_id="$(caddie_ledger_url_encode "$probe_session_id")"
    enc_checkpoint_id="$(caddie_ledger_url_encode "$probe_checkpoint_id")"
    enc_artifact_id="$(caddie_ledger_url_encode "$probe_artifact_id")"

    if [ "$created_event" -eq 1 ]; then
        caddie_ledger_supabase_json_request \
            "$supabase_url" \
            "$supabase_anon_key" \
            "DELETE" \
            "/rest/v1/events?session_id=eq.${enc_session_id}&type=eq.${probe_event_type}" \
            "" \
            "return=minimal" \
            "$cleanup_response_file" >/dev/null 2>&1 || true
    fi

    if [ "$created_artifact" -eq 1 ]; then
        caddie_ledger_supabase_json_request \
            "$supabase_url" \
            "$supabase_anon_key" \
            "DELETE" \
            "/rest/v1/artifacts?id=eq.${enc_artifact_id}" \
            "" \
            "return=minimal" \
            "$cleanup_response_file" >/dev/null 2>&1 || true
    fi

    if [ "$created_checkpoint" -eq 1 ]; then
        caddie_ledger_supabase_json_request \
            "$supabase_url" \
            "$supabase_anon_key" \
            "DELETE" \
            "/rest/v1/checkpoints?id=eq.${enc_checkpoint_id}" \
            "" \
            "return=minimal" \
            "$cleanup_response_file" >/dev/null 2>&1 || true
    fi

    if [ "$created_session" -eq 1 ]; then
        caddie_ledger_supabase_json_request \
            "$supabase_url" \
            "$supabase_anon_key" \
            "DELETE" \
            "/rest/v1/sessions?id=eq.${enc_session_id}" \
            "" \
            "return=minimal" \
            "$cleanup_response_file" >/dev/null 2>&1 || true
    fi

    rm -f "$response_file" "$storage_response_file" "$cleanup_response_file" "$probe_file"

    caddie cli:blank
    if [ "$checks_failed" -eq 0 ]; then
        caddie cli:check "Ledger sync check passed (${checks_total}/${checks_total})"
        return 0
    fi

    caddie cli:red "Ledger sync check failed (${checks_failed}/${checks_total} checks failed)"
    return 1
}

function caddie_ledger_verify_command_set() {
    local value="$1"
    if [ -z "$value" ]; then
        caddie cli:red "Error: Please provide a command"
        caddie cli:usage "caddie ledger:verify:command:set <command>"
        return 1
    fi

    export CADDIE_LEDGER_VERIFY_COMMAND="$value"
    caddie cli:check "Ledger verification command set"
    caddie cli:indent "command: $value"
    return 0
}

function caddie_ledger_verify_command_get() {
    local value="${CADDIE_LEDGER_VERIFY_COMMAND:-}"
    if [ -n "$value" ]; then
        caddie cli:green "Ledger verification command: $value"
    else
        caddie cli:yellow "No ledger verification command is set"
        caddie cli:thought "Default order: caddie verify (if available), then caddie core:lint"
        caddie cli:thought "Set one with: caddie ledger:verify:command:set <command>"
    fi
    return 0
}

function caddie_ledger_verify_command_unset() {
    if [ -n "${CADDIE_LEDGER_VERIFY_COMMAND:-}" ]; then
        unset CADDIE_LEDGER_VERIFY_COMMAND
        caddie cli:check "Ledger verification command unset"
    else
        caddie cli:yellow "No ledger verification command was set"
    fi
    return 0
}

function caddie_ledger_info() {
    local repo_root=""
    local ledger_dir=""
    local project_file=""
    local active_session=""
    local active_checkpoint=""
    local verify_command=""
    local config_file=""
    local auth_state="not configured"
    local schema_db_host_state="not set"
    local schema_db_password_state="not set"
    local schema_db_user=""
    local schema_db_port=""
    local schema_db_name=""

    repo_root="$(caddie_ledger_repo_root)"
    ledger_dir="$(caddie_ledger_dir "$repo_root")"
    project_file="$(caddie_ledger_project_file "$repo_root")"
    active_session="$(caddie_ledger_active_session_id "$repo_root")"
    active_checkpoint="$(caddie_ledger_active_checkpoint_id "$repo_root")"
    verify_command="$(caddie_ledger_verification_command_resolve)"
    config_file="$(caddie_ledger_config_file)"
    if [ -f "$config_file" ]; then
        auth_state="configured"
    fi
    if [ -n "$(caddie_ledger_schema_db_host_get_value)" ]; then
        schema_db_host_state="set"
    fi
    schema_db_user="$(caddie_ledger_schema_db_user_get_value)"
    schema_db_port="$(caddie_ledger_schema_db_port_get_value)"
    schema_db_name="$(caddie_ledger_schema_db_name_get_value)"
    if caddie_ledger_schema_db_password_read >/dev/null 2>&1; then
        schema_db_password_state="set"
    fi

    caddie cli:title "Ledger Info"
    caddie cli:indent "repo root: $repo_root"
    caddie cli:indent "ledger dir: $ledger_dir"
    if [ -f "$project_file" ]; then
        caddie cli:indent "project: initialized"
    else
        caddie cli:indent "project: not initialized"
    fi
    caddie cli:indent "active session: ${active_session:-none}"
    caddie cli:indent "active checkpoint: ${active_checkpoint:-none}"
    caddie cli:indent "verification command: $verify_command"
    caddie cli:indent "supabase auth: $auth_state"
    caddie cli:indent "supabase config: $config_file"
    caddie cli:indent "schema db host: $schema_db_host_state"
    caddie cli:indent "schema db user: $schema_db_user"
    caddie cli:indent "schema db port: $schema_db_port"
    caddie cli:indent "schema db name: $schema_db_name"
    caddie cli:indent "schema db password: $schema_db_password_state"
    return 0
}

