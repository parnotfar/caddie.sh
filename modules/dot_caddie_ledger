    value="$(sed -n "s/^[[:space:]]*\"${key}\":[[:space:]]*\"\\(.*\\)\"[[:space:]]*,\\{0,1\\}[[:space:]]*$/\\1/p" "$file_path" | head -n 1)"
    printf '%s' "$value"
    return 0
}

function caddie_ledger_json_read_number() {
