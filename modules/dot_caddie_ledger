function caddie_ledger_schema_sql() {
    cat <<'EOF'
-- Caddie Ledger Schema Bootstrap
-- Applies core ledger tables, storage buckets, grants, and baseline RLS policies.

create table if not exists public.projects (
  id text primary key,
  name text not null,
  repo_root text not null,
  created_at timestamptz not null default now()
);

create table if not exists public.sessions (
  id text primary key,
  project_id text not null references public.projects(id) on delete cascade,
  agent text not null,
  started_at timestamptz not null default now(),
  ended_at timestamptz null,
  labels jsonb not null default '{}'::jsonb
);

create table if not exists public.checkpoints (
  id text primary key,
  session_id text not null references public.sessions(id) on delete cascade,
  created_at timestamptz not null default now(),
  message text not null default '',
  snapshot_object text not null,
  provenance jsonb not null default '{}'::jsonb,
  verification jsonb not null default '{}'::jsonb,
  fingerprint text not null
);

create table if not exists public.artifacts (
  id text primary key,
  checkpoint_id text not null references public.checkpoints(id) on delete cascade,
  kind text not null,
  object_key text not null,
  meta jsonb not null default '{}'::jsonb
);

create table if not exists public.events (
  id bigint generated by default as identity primary key,
  session_id text not null references public.sessions(id) on delete cascade,
  ts timestamptz not null default now(),
  type text not null,
  payload jsonb not null default '{}'::jsonb
);

create index if not exists idx_sessions_project_id on public.sessions(project_id);
create index if not exists idx_checkpoints_session_id on public.checkpoints(session_id);
create index if not exists idx_artifacts_checkpoint_id on public.artifacts(checkpoint_id);
create index if not exists idx_events_session_id on public.events(session_id);

insert into storage.buckets (id, name, public)
values
  ('snapshots', 'snapshots', false),
  ('transcripts', 'transcripts', false),
  ('artifacts', 'artifacts', false)
on conflict (id) do nothing;

grant usage on schema public to anon, authenticated;
grant select, insert, update, delete on table public.projects to anon, authenticated;
grant select, insert, update, delete on table public.sessions to anon, authenticated;
grant select, insert, update, delete on table public.checkpoints to anon, authenticated;
grant select, insert, update, delete on table public.artifacts to anon, authenticated;
grant select, insert, update, delete on table public.events to anon, authenticated;
grant usage, select on all sequences in schema public to anon, authenticated;

alter table public.projects enable row level security;
alter table public.sessions enable row level security;
alter table public.checkpoints enable row level security;
alter table public.artifacts enable row level security;
alter table public.events enable row level security;

drop policy if exists projects_anon_all on public.projects;
create policy projects_anon_all on public.projects for all to anon using (true) with check (true);

drop policy if exists projects_authenticated_all on public.projects;
create policy projects_authenticated_all on public.projects for all to authenticated using (true) with check (true);

drop policy if exists sessions_anon_all on public.sessions;
create policy sessions_anon_all on public.sessions for all to anon using (true) with check (true);

drop policy if exists sessions_authenticated_all on public.sessions;
create policy sessions_authenticated_all on public.sessions for all to authenticated using (true) with check (true);

drop policy if exists checkpoints_anon_all on public.checkpoints;
create policy checkpoints_anon_all on public.checkpoints for all to anon using (true) with check (true);

drop policy if exists checkpoints_authenticated_all on public.checkpoints;
create policy checkpoints_authenticated_all on public.checkpoints for all to authenticated using (true) with check (true);

drop policy if exists artifacts_anon_all on public.artifacts;
create policy artifacts_anon_all on public.artifacts for all to anon using (true) with check (true);

drop policy if exists artifacts_authenticated_all on public.artifacts;
create policy artifacts_authenticated_all on public.artifacts for all to authenticated using (true) with check (true);

drop policy if exists events_anon_all on public.events;
create policy events_anon_all on public.events for all to anon using (true) with check (true);

drop policy if exists events_authenticated_all on public.events;
create policy events_authenticated_all on public.events for all to authenticated using (true) with check (true);

drop policy if exists storage_objects_anon_snapshots on storage.objects;
create policy storage_objects_anon_snapshots
on storage.objects for all to anon
using (bucket_id = 'snapshots') with check (bucket_id = 'snapshots');

drop policy if exists storage_objects_anon_transcripts on storage.objects;
create policy storage_objects_anon_transcripts
on storage.objects for all to anon
using (bucket_id = 'transcripts') with check (bucket_id = 'transcripts');

drop policy if exists storage_objects_anon_artifacts on storage.objects;
create policy storage_objects_anon_artifacts
on storage.objects for all to anon
using (bucket_id = 'artifacts') with check (bucket_id = 'artifacts');

drop policy if exists storage_objects_authenticated_snapshots on storage.objects;
create policy storage_objects_authenticated_snapshots
on storage.objects for all to authenticated
using (bucket_id = 'snapshots') with check (bucket_id = 'snapshots');

drop policy if exists storage_objects_authenticated_transcripts on storage.objects;
create policy storage_objects_authenticated_transcripts
on storage.objects for all to authenticated
using (bucket_id = 'transcripts') with check (bucket_id = 'transcripts');

drop policy if exists storage_objects_authenticated_artifacts on storage.objects;
create policy storage_objects_authenticated_artifacts
on storage.objects for all to authenticated
using (bucket_id = 'artifacts') with check (bucket_id = 'artifacts');
EOF
    return 0
}

function caddie_ledger_schema_init_run() {
    local mode="$1"
    local db_url_arg="$2"
    local db_url=""
    local db_password=""
    local use_pgpassword="false"
    local sql_file=""
    local apply_log=""
    local masked_db_url=""
    local psql_status=0

    if [ "$mode" = "dry" ]; then
        caddie cli:title "Ledger Schema SQL (Dry Run)"
        caddie_ledger_schema_sql
        return 0
    fi

    db_url="$(caddie_ledger_schema_db_url_resolve_from_input "$db_url_arg")"

    if [ -z "$db_url" ]; then
        caddie cli:red "Error: No schema DB host/URL provided"
        caddie cli:usage "caddie ledger:schema:init [db_host|postgres_url]"
        caddie cli:thought "Or set one: caddie ledger:schema:db:url:set <db_host|postgres_url>"
        return 1
    fi

    if ! caddie_ledger_schema_db_url_is_valid "$db_url"; then
        caddie cli:red "Error: Invalid schema DB URL: $db_url"
        caddie cli:indent "expected: postgresql://postgres@db.<project>.supabase.co:5432/postgres"
        caddie cli:thought "Set it with: caddie ledger:schema:db:url:set <db_host|postgres_url>"
        return 1
    fi

    if ! command -v psql >/dev/null 2>&1; then
        caddie cli:red "Error: 'psql' is required for schema initialization"
        caddie cli:thought "This command applies schema to your remote Supabase Postgres via client connection"
        caddie cli:thought "Install PostgreSQL client tools and try again"
        return 1
    fi

    sql_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-schema.XXXXXX.sql")"
    apply_log="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-schema.XXXXXX.log")"
    caddie_ledger_schema_sql > "$sql_file"

    masked_db_url="$(printf '%s' "$db_url" | sed -E 's#(://[^:/@]+):[^@]+@#\1:***@#')"
    if ! caddie_ledger_schema_db_url_has_inline_password "$db_url"; then
        db_password="$(caddie_ledger_schema_db_password_read 2>/dev/null || true)"
        if [ -n "$db_password" ]; then
            use_pgpassword="true"
        fi
    fi

    caddie cli:title "Ledger Schema Init"
    caddie cli:indent "target: $masked_db_url"
    caddie cli:indent "sql: $sql_file"
    if [ "$use_pgpassword" = "true" ]; then
        caddie cli:indent "auth: keychain password"
    else
        caddie cli:indent "auth: URL/env only"
    fi

    if [ "$use_pgpassword" = "true" ]; then
        env PGPASSWORD="$db_password" psql "$db_url" -v ON_ERROR_STOP=1 -f "$sql_file" > "$apply_log" 2>&1
    else
        psql "$db_url" -v ON_ERROR_STOP=1 -f "$sql_file" > "$apply_log" 2>&1
    fi
    psql_status=$?

    if [ "$psql_status" -eq 0 ]; then
        db_password=""
        caddie cli:check "Ledger schema applied successfully"
        rm -f "$sql_file" "$apply_log"
        return 0
    fi

    db_password=""
    caddie cli:red "Error: Ledger schema apply failed"
    caddie cli:indent "log: $apply_log"
    caddie cli:indent "tail:"
    tail -n 20 "$apply_log" | while IFS= read -r line; do
        caddie cli:indent "$line"
    done
    rm -f "$sql_file"
    return 1
}

function caddie_ledger_schema_init() {
    local db_url="$1"
    caddie_ledger_schema_init_run "apply" "$db_url"
    return $?
}

function caddie_ledger_schema_init_dry_run() {
    caddie_ledger_schema_init_run "dry" ""
    return $?
}

function caddie_ledger_json_query() {
    local file_path="$1"
    local query="$2"
    local value=""

    if [ ! -f "$file_path" ] || [ -z "$query" ]; then
        printf '%s' ""
        return 0
    fi

    if command -v jq >/dev/null 2>&1; then
        value="$(jq -r "${query} // \"\"" "$file_path" 2>/dev/null)"
        if [ "$value" = "null" ]; then
            value=""
        fi
        printf '%s' "$value"
        return 0
    fi

    if command -v python3 >/dev/null 2>&1; then
        value="$(python3 - "$file_path" "$query" <<'PY'
import json
import sys

path = sys.argv[1]
query = sys.argv[2].strip()

try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    print("")
    raise SystemExit(0)

if not query.startswith("."):
    print("")
    raise SystemExit(0)

node = data
parts = [p for p in query[1:].split(".") if p]
for part in parts:
    if isinstance(node, dict):
        node = node.get(part, "")
    else:
        node = ""
    if node == "":
        break

if isinstance(node, (dict, list)):
    print(json.dumps(node, separators=(",", ":")))
elif node is None:
    print("")
else:
    print(str(node))
PY
)"
        printf '%s' "$value"
        return 0
    fi

    printf '%s' ""
    return 0
}

