#!/usr/bin/env bash

# Caddie.sh - Ledger Module
# Local-first Agentic Ledger with checkpoint capsules.

source "$HOME/.caddie_modules/.caddie_cli"

function caddie_ledger_description() {
    printf '%s\n' 'Agentic ledger checkpoint capsules for local-first provenance'
    return 0
}

function caddie_ledger_timestamp_utc() {
    date -u +"%Y-%m-%dT%H:%M:%SZ"
    return 0
}

function caddie_ledger_json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '%s' "$value"
    return 0
}

function caddie_ledger_hash_file() {
    local path="$1"
    local hash=""

    if [ -z "$path" ] || [ ! -f "$path" ]; then
        return 1
    fi

    if command -v shasum >/dev/null 2>&1; then
        hash="$(shasum -a 256 "$path" 2>/dev/null | awk '{print $1}')"
    elif command -v sha256sum >/dev/null 2>&1; then
        hash="$(sha256sum "$path" 2>/dev/null | awk '{print $1}')"
    elif command -v openssl >/dev/null 2>&1; then
        hash="$(openssl dgst -sha256 "$path" 2>/dev/null | awk '{print $NF}')"
    fi

    if [ -z "$hash" ]; then
        return 1
    fi

    printf '%s' "$hash"
    return 0
}

function caddie_ledger_repo_root() {
    local repo_root=""
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -z "$repo_root" ]; then
        repo_root="$(pwd)"
    fi
    printf '%s' "$repo_root"
    return 0
}

function caddie_ledger_dir() {
    local repo_root="$1"
    if [ -z "$repo_root" ]; then
        repo_root="$(caddie_ledger_repo_root)"
    fi
    printf '%s' "$repo_root/.caddie/ledger"
    return 0
}

function caddie_ledger_project_file() {
    local repo_root="$1"
    printf '%s' "$(caddie_ledger_dir "$repo_root")/project.json"
    return 0
}

function caddie_ledger_sessions_dir() {
    local repo_root="$1"
    printf '%s' "$(caddie_ledger_dir "$repo_root")/sessions"
    return 0
}

function caddie_ledger_current_session_file() {
    local repo_root="$1"
    printf '%s' "$(caddie_ledger_dir "$repo_root")/current_session"
    return 0
}

function caddie_ledger_current_checkpoint_file() {
    local repo_root="$1"
    printf '%s' "$(caddie_ledger_dir "$repo_root")/current_checkpoint"
    return 0
}

function caddie_ledger_state_dir() {
    printf '%s' "$HOME/.caddie_state/ledger"
    return 0
}

function caddie_ledger_config_file() {
    printf '%s' "$(caddie_ledger_state_dir)/config.json"
    return 0
}

function caddie_ledger_config_ensure_state_dir() {
    local state_dir=""
    state_dir="$(caddie_ledger_state_dir)"

    if ! mkdir -p "$state_dir"; then
        caddie cli:red "Error: Unable to create ledger state directory at $state_dir"
        return 1
    fi

    chmod 700 "$(caddie_ledger_state_dir)" >/dev/null 2>&1 || true
    return 0
}

function caddie_ledger_config_read_value() {
    local key="$1"
    local config_file=""
    local value=""

    config_file="$(caddie_ledger_config_file)"
    if [ ! -f "$config_file" ]; then
        printf '%s' ""
        return 0
    fi

    if command -v jq >/dev/null 2>&1; then
        value="$(jq -r --arg key "$key" '.[$key] // ""' "$config_file" 2>/dev/null)"
    else
        value="$(sed -n "s/^[[:space:]]*\"${key}\"[[:space:]]*:[[:space:]]*\"\\(.*\\)\"[[:space:]]*,\\{0,1\\}[[:space:]]*$/\\1/p" "$config_file" | head -n 1)"
    fi

    if [ "$value" = "null" ]; then
        value=""
    fi
    printf '%s' "$value"
    return 0
}

function caddie_ledger_config_bucket_value() {
    local key="$1"
    local default_value="$2"
    local value=""

    value="$(caddie_ledger_config_read_value "$key")"
    if [ -z "$value" ]; then
        value="$default_value"
    fi

    printf '%s' "$value"
    return 0
}

function caddie_ledger_config_write_json() {
    local supabase_url="$1"
    local supabase_anon_key="$2"
    local project_id="$3"
    local snapshots_bucket="$4"
    local transcripts_bucket="$5"
    local artifacts_bucket="$6"
    local config_file=""
    local escaped_url=""
    local escaped_key=""
    local escaped_project_id=""
    local escaped_snapshots_bucket=""
    local escaped_transcripts_bucket=""
    local escaped_artifacts_bucket=""

    config_file="$(caddie_ledger_config_file)"
    escaped_url="$(caddie_ledger_json_escape "$supabase_url")"
    escaped_key="$(caddie_ledger_json_escape "$supabase_anon_key")"
    escaped_project_id="$(caddie_ledger_json_escape "$project_id")"
    escaped_snapshots_bucket="$(caddie_ledger_json_escape "$snapshots_bucket")"
    escaped_transcripts_bucket="$(caddie_ledger_json_escape "$transcripts_bucket")"
    escaped_artifacts_bucket="$(caddie_ledger_json_escape "$artifacts_bucket")"

    cat > "$config_file" <<EOF
{
  "supabase_url": "${escaped_url}",
  "supabase_anon_key": "${escaped_key}",
  "project_id": "${escaped_project_id}",
  "snapshots_bucket": "${escaped_snapshots_bucket}",
  "transcripts_bucket": "${escaped_transcripts_bucket}",
  "artifacts_bucket": "${escaped_artifacts_bucket}"
}
EOF
    chmod 600 "$config_file" >/dev/null 2>&1 || true
    return $?
}

function caddie_ledger_schema_db_url_file() {
    printf '%s' "$(caddie_ledger_state_dir)/db_url"
    return 0
}

function caddie_ledger_schema_db_host_file() {
    printf '%s' "$(caddie_ledger_state_dir)/db_host"
    return 0
}

function caddie_ledger_schema_db_user_file() {
    printf '%s' "$(caddie_ledger_state_dir)/db_user"
    return 0
}

function caddie_ledger_schema_db_port_file() {
    printf '%s' "$(caddie_ledger_state_dir)/db_port"
    return 0
}

function caddie_ledger_schema_db_name_file() {
    printf '%s' "$(caddie_ledger_state_dir)/db_name"
    return 0
}

function caddie_ledger_schema_db_file_read() {
    local file_path="$1"
    local value=""

    if [ ! -f "$file_path" ]; then
        printf '%s' ""
        return 0
    fi

    value="$(cat "$file_path" 2>/dev/null || true)"
    printf '%s' "$value"
    return 0
}

function caddie_ledger_schema_db_file_write() {
    local file_path="$1"
    local value="$2"
    local label="$3"

    if ! caddie_ledger_config_ensure_state_dir; then
        return 1
    fi

    if ! printf '%s\n' "$value" > "$file_path"; then
        caddie cli:red "Error: Unable to save schema DB $label"
        return 1
    fi

    chmod 600 "$file_path" >/dev/null 2>&1 || true
    return 0
}

function caddie_ledger_schema_db_file_clear() {
    local file_path="$1"
    local label="$2"

    if [ ! -f "$file_path" ]; then
        caddie cli:yellow "No ledger schema DB $label was set"
        return 0
    fi

    if ! rm -f "$file_path"; then
        caddie cli:red "Error: Unable to clear schema DB $label"
        return 1
    fi

    caddie cli:check "Ledger schema DB $label cleared"
    return 0
}

function caddie_ledger_schema_db_value_is_url() {
    local value="$1"

    if [ -n "$(printf '%s' "$value" | sed -nE 's#^postgres(ql)?://.+#ok#p')" ]; then
        return 0
    fi

    return 1
}

function caddie_ledger_schema_db_url_extract_host() {
    local value="$1"
    local host=""

    host="$(printf '%s' "$value" | sed -nE 's#^[a-zA-Z0-9+.-]+://([^/@]+@)?([^/:?]+).*$#\2#p' | head -n 1)"
    printf '%s' "$host"
    return 0
}

function caddie_ledger_schema_db_url_extract_user() {
    local value="$1"
    local user=""

    user="$(printf '%s' "$value" | sed -nE 's#^[a-zA-Z0-9+.-]+://([^:/@]+)(:[^@]*)?@.*$#\1#p' | head -n 1)"
    printf '%s' "$user"
    return 0
}

function caddie_ledger_schema_db_url_extract_port() {
    local value="$1"
    local port=""

    port="$(printf '%s' "$value" | sed -nE 's#^[a-zA-Z0-9+.-]+://([^/@]+@)?[^/:?]+:([0-9]+)(/.*)?$#\2#p' | head -n 1)"
    printf '%s' "$port"
    return 0
}

function caddie_ledger_schema_db_url_extract_name() {
    local value="$1"
    local name=""

    name="$(printf '%s' "$value" | sed -nE 's#^[a-zA-Z0-9+.-]+://([^/@]+@)?[^/?]+/([^?]+).*$#\2#p' | head -n 1)"
    printf '%s' "$name"
    return 0
}

function caddie_ledger_schema_db_host_normalize() {
    local value="$1"
    local host="$value"

    if caddie_ledger_schema_db_value_is_url "$value"; then
        host="$(caddie_ledger_schema_db_url_extract_host "$value")"
        printf '%s' "$host"
        return 0
    fi

    host="${host#*://}"
    if [ "${host#*@}" != "$host" ]; then
        host="${host#*@}"
    fi
    host="${host%%/*}"
    if [ "${host%%:*}" != "$host" ]; then
        host="${host%%:*}"
    fi

    printf '%s' "$host"
    return 0
}

function caddie_ledger_schema_db_non_url_port_extract() {
    local value="$1"
    local segment="$value"
    local port=""

    segment="${segment#*://}"
    if [ "${segment#*@}" != "$segment" ]; then
        segment="${segment#*@}"
    fi
    segment="${segment%%/*}"
    if [ "${segment%%:*}" != "$segment" ]; then
        port="${segment##*:}"
    fi

    printf '%s' "$port"
    return 0
}

function caddie_ledger_schema_db_host_is_valid() {
    local host="$1"
    if [ -n "$(printf '%s' "$host" | sed -nE 's#^[A-Za-z0-9.-]+$#ok#p')" ]; then
        return 0
    fi
    return 1
}

function caddie_ledger_schema_db_port_is_valid() {
    local port="$1"
    if [ -n "$(printf '%s' "$port" | sed -nE 's#^[0-9]+$#ok#p')" ]; then
        return 0
    fi
    return 1
}

function caddie_ledger_schema_db_user_is_valid() {
    local user="$1"
    if [ -n "$(printf '%s' "$user" | sed -nE 's#^[A-Za-z0-9_.-]+$#ok#p')" ]; then
        return 0
    fi
    return 1
}

function caddie_ledger_schema_db_name_is_valid() {
    local name="$1"
    if [ -n "$(printf '%s' "$name" | sed -nE 's#^[A-Za-z0-9_.-]+$#ok#p')" ]; then
        return 0
    fi
    return 1
}

function caddie_ledger_schema_db_host_get_value() {
    local value=""
    local legacy_value=""

    value="$(caddie_ledger_schema_db_file_read "$(caddie_ledger_schema_db_host_file)")"
    if [ -n "$value" ]; then
        printf '%s' "$value"
        return 0
    fi

    legacy_value="$(caddie_ledger_schema_db_file_read "$(caddie_ledger_schema_db_url_file)")"
    if [ -z "$legacy_value" ]; then
        printf '%s' ""
        return 0
    fi

    value="$(caddie_ledger_schema_db_host_normalize "$legacy_value")"
    printf '%s' "$value"
    return 0
}

function caddie_ledger_schema_db_user_get_value() {
    local value=""
    local legacy_value=""

    value="$(caddie_ledger_schema_db_file_read "$(caddie_ledger_schema_db_user_file)")"
    if [ -n "$value" ]; then
        printf '%s' "$value"
        return 0
    fi

    legacy_value="$(caddie_ledger_schema_db_file_read "$(caddie_ledger_schema_db_url_file)")"
    if caddie_ledger_schema_db_value_is_url "$legacy_value"; then
        value="$(caddie_ledger_schema_db_url_extract_user "$legacy_value")"
        if [ -n "$value" ]; then
            printf '%s' "$value"
            return 0
        fi
    fi

    printf '%s' "postgres"
    return 0
}

function caddie_ledger_schema_db_port_get_value() {
    local value=""
    local legacy_value=""

    value="$(caddie_ledger_schema_db_file_read "$(caddie_ledger_schema_db_port_file)")"
    if [ -n "$value" ]; then
        printf '%s' "$value"
        return 0
    fi

    legacy_value="$(caddie_ledger_schema_db_file_read "$(caddie_ledger_schema_db_url_file)")"
    if caddie_ledger_schema_db_value_is_url "$legacy_value"; then
        value="$(caddie_ledger_schema_db_url_extract_port "$legacy_value")"
        if [ -n "$value" ]; then
            printf '%s' "$value"
            return 0
        fi
    fi

    printf '%s' "5432"
    return 0
}

function caddie_ledger_schema_db_name_get_value() {
    local value=""
    local legacy_value=""

    value="$(caddie_ledger_schema_db_file_read "$(caddie_ledger_schema_db_name_file)")"
    if [ -n "$value" ]; then
        printf '%s' "$value"
        return 0
    fi

    legacy_value="$(caddie_ledger_schema_db_file_read "$(caddie_ledger_schema_db_url_file)")"
    if caddie_ledger_schema_db_value_is_url "$legacy_value"; then
        value="$(caddie_ledger_schema_db_url_extract_name "$legacy_value")"
        if [ -n "$value" ]; then
            printf '%s' "$value"
            return 0
        fi
    fi

    printf '%s' "postgres"
    return 0
}

function caddie_ledger_schema_db_url_compose() {
    local host="$1"
    local user="$2"
    local port="$3"
    local name="$4"

    if [ -z "$host" ] || [ -z "$user" ] || [ -z "$port" ] || [ -z "$name" ]; then
        printf '%s' ""
        return 0
    fi

    printf '%s' "postgresql://${user}@${host}:${port}/${name}"
    return 0
}

function caddie_ledger_schema_db_url_get_value() {
    local host=""
    local user=""
    local port=""
    local name=""

    host="$(caddie_ledger_schema_db_host_get_value)"
    if [ -z "$host" ]; then
        printf '%s' ""
        return 0
    fi

    user="$(caddie_ledger_schema_db_user_get_value)"
    port="$(caddie_ledger_schema_db_port_get_value)"
    name="$(caddie_ledger_schema_db_name_get_value)"
    caddie_ledger_schema_db_url_compose "$host" "$user" "$port" "$name"
    return 0
}

function caddie_ledger_schema_db_url_is_valid() {
    local value="$1"

    if [ -z "$value" ]; then
        return 1
    fi

    if [ -n "$(printf '%s' "$value" | sed -nE 's#^postgres(ql)?://.+#ok#p')" ]; then
        return 0
    fi

    return 1
}

function caddie_ledger_schema_db_url_set() {
    local value="$1"
    local host=""
    local user=""
    local port=""
    local name=""

    if [ -z "$value" ]; then
        caddie cli:red "Error: Please provide a DB host or Postgres connection URL"
        caddie cli:usage "caddie ledger:schema:db:url:set <db_host|postgres_url>"
        return 1
    fi

    if ! caddie_ledger_config_ensure_state_dir; then
        return 1
    fi

    if caddie_ledger_schema_db_value_is_url "$value"; then
        host="$(caddie_ledger_schema_db_url_extract_host "$value")"
        user="$(caddie_ledger_schema_db_url_extract_user "$value")"
        port="$(caddie_ledger_schema_db_url_extract_port "$value")"
        name="$(caddie_ledger_schema_db_url_extract_name "$value")"
        if caddie_ledger_schema_db_url_has_inline_password "$value"; then
            caddie cli:yellow "Password segment detected in URL; password will not be stored"
            caddie cli:thought "Use 'caddie ledger:schema:db:password:set [password]' for secure password storage"
        fi
    else
        host="$(caddie_ledger_schema_db_host_normalize "$value")"
        port="$(caddie_ledger_schema_db_non_url_port_extract "$value")"
    fi

    if ! caddie_ledger_schema_db_host_is_valid "$host"; then
        caddie cli:red "Error: Invalid DB host: $host"
        caddie cli:indent "expected host like: db.<project>.supabase.co"
        return 1
    fi

    if ! caddie_ledger_schema_db_file_write "$(caddie_ledger_schema_db_host_file)" "$host" "host"; then
        return 1
    fi
    caddie_ledger_schema_db_file_write "$(caddie_ledger_schema_db_url_file)" "$host" "url base" >/dev/null 2>&1 || true

    if [ -n "$user" ] && caddie_ledger_schema_db_user_is_valid "$user"; then
        caddie_ledger_schema_db_file_write "$(caddie_ledger_schema_db_user_file)" "$user" "user" >/dev/null 2>&1 || true
    fi
    if [ -n "$port" ] && caddie_ledger_schema_db_port_is_valid "$port"; then
        caddie_ledger_schema_db_file_write "$(caddie_ledger_schema_db_port_file)" "$port" "port" >/dev/null 2>&1 || true
    fi
    if [ -n "$name" ] && caddie_ledger_schema_db_name_is_valid "$name"; then
        caddie_ledger_schema_db_file_write "$(caddie_ledger_schema_db_name_file)" "$name" "name" >/dev/null 2>&1 || true
    fi

    caddie cli:check "Ledger schema DB base set"
    caddie cli:indent "host: $host"
    caddie cli:indent "effective url: $(caddie_ledger_schema_db_url_get_value)"
    return 0
}

function caddie_ledger_schema_db_url_get() {
    local host=""
    local user=""
    local port=""
    local name=""
    local url=""

    host="$(caddie_ledger_schema_db_host_get_value)"
    if [ -z "$host" ]; then
        caddie cli:yellow "No ledger schema DB host is set"
        caddie cli:thought "Use 'caddie ledger:schema:db:url:set <db_host|postgres_url>' to set it"
        return 0
    fi

    user="$(caddie_ledger_schema_db_user_get_value)"
    port="$(caddie_ledger_schema_db_port_get_value)"
    name="$(caddie_ledger_schema_db_name_get_value)"
    url="$(caddie_ledger_schema_db_url_get_value)"

    caddie cli:green "Ledger schema DB host: $host"
    caddie cli:indent "user: $user"
    caddie cli:indent "port: $port"
    caddie cli:indent "name: $name"
    caddie cli:indent "effective url: $url"
    return 0
}

function caddie_ledger_schema_db_url_unset() {
    if ! caddie_ledger_schema_db_file_clear "$(caddie_ledger_schema_db_host_file)" "host"; then
        return 1
    fi
    rm -f "$(caddie_ledger_schema_db_url_file)" >/dev/null 2>&1 || true
    return 0
}

function caddie_ledger_schema_db_user_set() {
    local value="$1"

    if [ -z "$value" ]; then
        caddie cli:red "Error: Please provide a DB user"
        caddie cli:usage "caddie ledger:schema:db:user:set <user>"
        return 1
    fi

    if ! caddie_ledger_schema_db_user_is_valid "$value"; then
        caddie cli:red "Error: Invalid DB user"
        return 1
    fi

    if ! caddie_ledger_schema_db_file_write "$(caddie_ledger_schema_db_user_file)" "$value" "user"; then
        return 1
    fi

    caddie cli:check "Ledger schema DB user set"
    caddie cli:indent "user: $value"
    return 0
}

function caddie_ledger_schema_db_user_get() {
    caddie cli:green "Ledger schema DB user: $(caddie_ledger_schema_db_user_get_value)"
    return 0
}

function caddie_ledger_schema_db_user_unset() {
    if ! caddie_ledger_schema_db_file_clear "$(caddie_ledger_schema_db_user_file)" "user override"; then
        return 1
    fi
    caddie cli:indent "default user: postgres"
    return 0
}

