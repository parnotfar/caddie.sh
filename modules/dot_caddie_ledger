function caddie_ledger_collect_repo_files() {
    local repo_root="$1"
    local list_file="$2"

    if git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        (cd "$repo_root" && git ls-files --cached --others --exclude-standard -z) > "$list_file"
    else
        (cd "$repo_root" && find . -type f ! -path "./.git/*" ! -path "./.caddie/ledger/*" -print0) > "$list_file"
    fi

    return $?
}

function caddie_ledger_snapshot_build() {
    local repo_root="$1"
    local checkpoint_dir="$2"
    local file_hashes_path="$3"
    local list_file=""
    local stage_dir=""
    local snapshot_zip=""
    local rel_path=""
    local src_path=""
    local dst_path=""
    local dst_dir=""
    local file_hash=""
    local file_size=0
    local file_count=0
    local total_bytes=0
    local snapshot_hash=""
    local tree_hash="none"
    local summary=""
    local snapshot_error=0

    if ! command -v zip >/dev/null 2>&1; then
        caddie cli:red "Error: 'zip' command is required for ledger checkpoints"
        return 1
    fi

    list_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-files.XXXXXX")"
    stage_dir="$(mktemp -d "${TMPDIR:-/tmp}/caddie-ledger-stage.XXXXXX")"
    snapshot_zip="${checkpoint_dir}/snapshot.zip"

    : > "$file_hashes_path"

    if ! caddie_ledger_collect_repo_files "$repo_root" "$list_file"; then
        rm -f "$list_file"
        rm -rf "$stage_dir"
        caddie cli:red "Error: Unable to collect repository files for snapshot"
        return 1
    fi

    while IFS= read -r -d '' rel_path; do
        rel_path="${rel_path#./}"
        if [ -z "$rel_path" ]; then
            continue
        fi
        if [[ "$rel_path" == .caddie/ledger/* ]] || [[ "$rel_path" == .git/* ]]; then
            continue
        fi

        src_path="${repo_root}/${rel_path}"
        if [ ! -f "$src_path" ]; then
            continue
        fi

        dst_path="${stage_dir}/${rel_path}"
        dst_dir="$(dirname "$dst_path")"
        if ! mkdir -p "$dst_dir"; then
            caddie cli:red "Error: Unable to prepare snapshot staging directory"
            snapshot_error=1
            break
        fi

        if ! cp -p "$src_path" "$dst_path"; then
            caddie cli:red "Error: Unable to copy '$rel_path' into snapshot staging area"
            snapshot_error=1
            break
        fi

        file_hash="$(caddie_ledger_hash_file "$src_path")"
        if [ -z "$file_hash" ]; then
            caddie cli:red "Error: Unable to hash '$rel_path'"
            snapshot_error=1
            break
        fi
        printf '%s  %s\n' "$file_hash" "$rel_path" >> "$file_hashes_path"

        file_size="$(wc -c < "$src_path" | tr -d '[:space:]')"
        if [ -z "$file_size" ]; then
            file_size=0
        fi
        file_count=$((file_count + 1))
        total_bytes=$((total_bytes + file_size))
    done < "$list_file"

    if [ "$snapshot_error" -ne 0 ]; then
        rm -f "$list_file"
        rm -rf "$stage_dir"
        return 1
    fi

    if [ "$file_count" -eq 0 ]; then
        if command -v python3 >/dev/null 2>&1; then
            if ! python3 - "$snapshot_zip" <<'PY'
import sys
import zipfile
zipfile.ZipFile(sys.argv[1], mode="w").close()
PY
            then
                rm -f "$list_file"
                rm -rf "$stage_dir"
                caddie cli:red "Error: Unable to create empty snapshot archive"
                return 1
            fi
        else
            : > "${stage_dir}/.ledger-empty"
            if ! (cd "$stage_dir" && zip -q -r "$snapshot_zip" ".ledger-empty"); then
                rm -f "$list_file"
                rm -rf "$stage_dir"
                caddie cli:red "Error: Unable to create snapshot archive"
                return 1
            fi
        fi
    else
        if ! (cd "$stage_dir" && zip -q -r "$snapshot_zip" .); then
            rm -f "$list_file"
            rm -rf "$stage_dir"
            caddie cli:red "Error: Unable to create snapshot archive"
            return 1
        fi
    fi

    snapshot_hash="$(caddie_ledger_hash_file "$snapshot_zip")"
    if [ -z "$snapshot_hash" ]; then
        rm -f "$list_file"
        rm -rf "$stage_dir"
        caddie cli:red "Error: Unable to hash snapshot archive"
        return 1
    fi

    if [ -s "$file_hashes_path" ]; then
        tree_hash="$(caddie_ledger_hash_file "$file_hashes_path")"
        if [ -z "$tree_hash" ]; then
            tree_hash="none"
        fi
    fi

    rm -f "$list_file"
    rm -rf "$stage_dir"

    summary="${file_count}|${total_bytes}|${tree_hash}|${snapshot_hash}"
    printf '%s' "$summary"
    return 0
}

function caddie_ledger_write_manifest() {
    local manifest_path="$1"
    local repo_root="$2"
    local session_id="$3"
    local checkpoint_id="$4"
    local created_at="$5"
    local message="$6"
    local branch="$7"
    local git_sha="$8"
    local file_count="$9"
    local total_bytes="${10}"
    local tree_hash="${11}"
    local snapshot_hash="${12}"
    local verify_command="${13}"
    local verify_exit="${14}"
    local verify_status="${15}"
    local artifact_count="${16}"
    local escaped_repo_root=""
    local escaped_message=""
    local escaped_branch=""
    local escaped_git_sha=""
    local escaped_verify=""

    escaped_repo_root="$(caddie_ledger_json_escape "$repo_root")"
    escaped_message="$(caddie_ledger_json_escape "$message")"
    escaped_branch="$(caddie_ledger_json_escape "$branch")"
    escaped_git_sha="$(caddie_ledger_json_escape "$git_sha")"
    escaped_verify="$(caddie_ledger_json_escape "$verify_command")"

    cat > "$manifest_path" <<EOF
{
  "schema_version": 1,
  "session_id": "${session_id}",
  "checkpoint_id": "${checkpoint_id}",
  "created_at": "${created_at}",
  "message": "${escaped_message}",
  "repo": {
    "root": "${escaped_repo_root}",
    "branch": "${escaped_branch}",
    "git_sha": "${escaped_git_sha}"
  },
  "snapshot": {
    "path": "snapshot.zip",
    "sha256": "${snapshot_hash}",
    "file_count": ${file_count},
    "total_bytes": ${total_bytes},
    "tree_sha256": "${tree_hash}",
    "respects_gitignore": true
  },
  "verification": {
    "command": "${escaped_verify}",
    "status": "${verify_status}",
    "exit_code": ${verify_exit},
    "log_path": "verification/verify.log"
  },
  "artifacts": {
    "artifact_count": ${artifact_count},
    "index_path": "artifacts/index.jsonl"
  }
}
EOF
    return $?
}

function caddie_ledger_manifest_update_artifact_count() {
    local manifest_path="$1"
    local artifact_count="$2"
    local temp_file=""

    if [ ! -f "$manifest_path" ]; then
        return 1
    fi

    temp_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-manifest.XXXXXX")"
    if ! awk -v count="$artifact_count" '
        {
            if ($0 ~ /"artifact_count":/) {
                sub(/"artifact_count":[[:space:]]*[0-9]+/, "\"artifact_count\": " count)
            }
            print
        }
    ' "$manifest_path" > "$temp_file"; then
        rm -f "$temp_file"
        return 1
    fi

    if ! mv "$temp_file" "$manifest_path"; then
        rm -f "$temp_file"
        return 1
    fi

    return 0
}

function caddie_ledger_require_project() {
    local repo_root="$1"
    local project_file=""

    project_file="$(caddie_ledger_project_file "$repo_root")"
    if [ ! -f "$project_file" ]; then
        caddie cli:red "Error: Ledger project is not initialized"
        caddie cli:usage "caddie ledger:project:init"
        return 1
    fi
    return 0
}

function caddie_ledger_project_init() {
    local repo_root=""
    local ledger_dir=""
    local project_file=""
    local project_name=""
    local created_at=""

    repo_root="$(caddie_ledger_repo_root)"
    ledger_dir="$(caddie_ledger_dir "$repo_root")"
    project_file="$(caddie_ledger_project_file "$repo_root")"
    project_name="$(basename "$repo_root")"
    created_at="$(caddie_ledger_timestamp_utc)"

    if ! caddie_ledger_ensure_layout "$repo_root"; then
        return 1
    fi

    if [ -f "$project_file" ]; then
        caddie cli:yellow "Ledger project already initialized"
        caddie cli:indent "project file: $project_file"
        return 0
    fi

    if ! caddie_ledger_write_project_json "$project_file" "$repo_root" "$project_name" "$created_at"; then
        caddie cli:red "Error: Unable to write ledger project file"
        return 1
    fi

    caddie cli:check "Ledger project initialized"
    caddie cli:indent "repo root: $repo_root"
    caddie cli:indent "ledger dir: $ledger_dir"
    return 0
}

function caddie_ledger_session_start() {
    local normalized_agents=""
    local agent_item=""
    local agent_summary=""
    local watch_agents=""
    local repo_root=""
    local sessions_dir=""
    local session_id=""
    local session_dir=""
    local session_file=""
    local started_at=""
    local current_session_file=""
    local current_checkpoint_file=""
    local watch_status="configured"

    for agent_item in "$@"; do
        agent_item="$(printf '%s' "$agent_item" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
        if [ -z "$agent_item" ]; then
            continue
        fi
        if printf ' %s ' "$normalized_agents" | grep -Fq " ${agent_item} "; then
            continue
        fi
        if [ -z "$normalized_agents" ]; then
            normalized_agents="$agent_item"
        else
            normalized_agents="${normalized_agents} ${agent_item}"
        fi
    done

    if [ -z "$normalized_agents" ]; then
        normalized_agents="unknown"
    fi

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    sessions_dir="$(caddie_ledger_sessions_dir "$repo_root")"
    if ! mkdir -p "$sessions_dir"; then
        caddie cli:red "Error: Unable to create sessions directory"
        return 1
    fi

    session_id="$(caddie_ledger_new_session_id "$sessions_dir")"
    session_dir="${sessions_dir}/${session_id}"
    session_file="${session_dir}/session.json"
    started_at="$(caddie_ledger_timestamp_utc)"
    current_session_file="$(caddie_ledger_current_session_file "$repo_root")"
    current_checkpoint_file="$(caddie_ledger_current_checkpoint_file "$repo_root")"
    agent_summary="$(printf '%s' "$normalized_agents" | tr ' ' ',')"
    watch_agents="$normalized_agents"

    if ! mkdir -p "$session_dir/checkpoints"; then
        caddie cli:red "Error: Unable to create session directory"
        return 1
    fi

    if ! caddie_ledger_write_session_json "$session_file" "$session_id" "$agent_summary" "$started_at" "0" "" ""; then
        caddie cli:red "Error: Unable to write session metadata"
        return 1
    fi

    printf '%s\n' "$session_id" > "$current_session_file"
    rm -f "$current_checkpoint_file"
    if ! caddie_ledger_agent_watch $watch_agents >/dev/null 2>&1; then
        watch_status="failed"
    fi

    caddie cli:check "Ledger session started"
    caddie cli:indent "session: $session_id"
    caddie cli:indent "agents: $agent_summary"
    caddie cli:indent "watch: $watch_status"
    if [ "$watch_status" = "failed" ]; then
        caddie cli:yellow "Could not configure watched agents automatically"
        caddie cli:thought "Run: caddie ledger:agent:watch ${agent_summary//,/ }"
    fi
    return 0
}

function caddie_ledger_session_watch_file() {
    local repo_root="$1"
    local session_id="$2"
    printf '%s' "$(caddie_ledger_sessions_dir "$repo_root")/${session_id}/watch_agents"
    return 0
}

function caddie_ledger_collect_source_info() {
    local agent="$1"
    local source_path=""
    local state="unsupported"

    case "$agent" in
        codex)
            source_path="$HOME/.codex/history.jsonl"
            if [ -f "$source_path" ]; then
                state="ready"
            else
                state="missing"
            fi
            ;;
        caddie)
            source_path="$HOME/.caddie_history"
            if [ -f "$source_path" ]; then
                state="ready"
            else
                state="missing"
            fi
            ;;
        cursor)
            source_path="$HOME/Library/Application Support/Cursor/User/workspaceStorage"
            if [ -d "$source_path" ]; then
                state="ready"
            else
                state="missing"
            fi
            ;;
        claude)
            source_path=""
            state="unsupported"
            ;;
        *)
            source_path=""
            state="unsupported"
            ;;
    esac

    printf '%s|%s' "$state" "$source_path"
    return 0
}

function caddie_ledger_agent_watch() {
    local repo_root=""
    local session_id=""
    local watch_file=""
    local temp_file=""
    local agent=""
    local normalized=""
    local has_any=0

    if [ "$#" -eq 0 ]; then
        caddie cli:red "Error: Please provide one or more agent names"
        caddie cli:usage "caddie ledger:agent:watch <agents...>"
        return 1
    fi

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    session_id="$(caddie_ledger_active_session_id "$repo_root")"
    if [ -z "$session_id" ]; then
        caddie cli:red "Error: No active ledger session"
        caddie cli:usage "caddie ledger:session:start [agents...]"
        return 1
    fi

    watch_file="$(caddie_ledger_session_watch_file "$repo_root" "$session_id")"
    temp_file="$(mktemp "${TMPDIR:-/tmp}/caddie-ledger-watch.XXXXXX")"
    : > "$temp_file"

    for agent in "$@"; do
        normalized="$(printf '%s' "$agent" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
        if [ -z "$normalized" ]; then
            continue
        fi
        if ! grep -Fxq "$normalized" "$temp_file" >/dev/null 2>&1; then
            printf '%s\n' "$normalized" >> "$temp_file"
            has_any=1
        fi
    done

    if [ "$has_any" -eq 0 ]; then
        rm -f "$temp_file"
        caddie cli:red "Error: No valid agent names were provided"
        return 1
    fi

    if ! mv "$temp_file" "$watch_file"; then
        rm -f "$temp_file"
        caddie cli:red "Error: Unable to save watched agents"
        return 1
    fi

    caddie cli:check "Ledger watched agents updated"
    caddie cli:indent "session: $session_id"
    while IFS= read -r normalized; do
        if [ -n "$normalized" ]; then
            caddie cli:indent "watch: $normalized"
        fi
    done < "$watch_file"
    return 0
}

function caddie_ledger_agent_watch_list() {
    local repo_root=""
    local session_id=""
    local watch_file=""
    local agent=""
    local source_info=""
    local source_state=""
    local source_path=""

    repo_root="$(caddie_ledger_repo_root)"
    if ! caddie_ledger_require_project "$repo_root"; then
        return 1
    fi

    session_id="$(caddie_ledger_active_session_id "$repo_root")"
    if [ -z "$session_id" ]; then
        caddie cli:red "Error: No active ledger session"
        caddie cli:usage "caddie ledger:session:start [agents...]"
        return 1
    fi

    watch_file="$(caddie_ledger_session_watch_file "$repo_root" "$session_id")"

    caddie cli:title "Ledger Watched Agents"
    caddie cli:indent "session: $session_id"
    if [ ! -f "$watch_file" ] || [ ! -s "$watch_file" ]; then
        caddie cli:yellow "No watched agents configured"
        caddie cli:thought "Use: caddie ledger:agent:watch codex cursor"
        return 0
    fi

    while IFS= read -r agent; do
        if [ -z "$agent" ]; then
            continue
        fi
        source_info="$(caddie_ledger_collect_source_info "$agent")"
        source_state="$(printf '%s' "$source_info" | cut -d'|' -f1)"
        source_path="$(printf '%s' "$source_info" | cut -d'|' -f2-)"
        if [ -n "$source_path" ]; then
            caddie cli:indent "$agent: $source_state ($source_path)"
        else
            caddie cli:indent "$agent: $source_state"
        fi
    done < "$watch_file"
    return 0
}

