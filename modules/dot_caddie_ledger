    fi

    caddie cli:check "Ledger schema DB name set"
    caddie cli:indent "name: $value"
    return 0
}

function caddie_ledger_schema_db_name_get() {
    caddie cli:green "Ledger schema DB name: $(caddie_ledger_schema_db_name_get_value)"
    return 0
}

function caddie_ledger_schema_db_name_unset() {
    if ! caddie_ledger_schema_db_file_clear "$(caddie_ledger_schema_db_name_file)" "name override"; then
        return 1
    fi
    caddie cli:indent "default name: postgres"
    return 0
}

function caddie_ledger_schema_keychain_service() {
    printf '%s' "caddie.ledger.schema.db.password"
    return 0
}

function caddie_ledger_schema_keychain_account() {
    local project_id=""
    local host=""

    host="$(caddie_ledger_schema_db_host_get_value)"
    if [ -n "$host" ]; then
        printf '%s' "$host"
        return 0
    fi

    project_id="$(caddie_ledger_config_read_value "project_id")"
    if [ -n "$project_id" ]; then
        printf '%s' "$project_id"
        return 0
    fi

    printf '%s' "default"
    return 0
}

function caddie_ledger_schema_db_password_read() {
    local account=""
    local service=""
    local password=""

    if ! command -v security >/dev/null 2>&1; then
        return 1
    fi

    account="$(caddie_ledger_schema_keychain_account)"
    service="$(caddie_ledger_schema_keychain_service)"
    password="$(security find-generic-password -a "$account" -s "$service" -w 2>/dev/null || true)"

    if [ -z "$password" ]; then
        return 1
    fi

    printf '%s' "$password"
    return 0
}

function caddie_ledger_schema_db_password_set() {
    local password="$1"
    local account=""
    local service=""

    if [ -z "$password" ]; then
        if [ ! -t 0 ]; then
            caddie cli:red "Error: No database password provided and stdin is not interactive"
            caddie cli:usage "caddie ledger:schema:db:password:set [password]"
            return 1
        fi

        caddie cli:indent "Enter database password (input hidden):"
        if ! IFS= read -r -s password; then
            printf '\n'
            caddie cli:red "Error: Failed to read database password"
            return 1
        fi
        printf '\n'
    fi

    if [ -z "$password" ]; then
        caddie cli:red "Error: Database password cannot be empty"
        return 1
    fi

    if ! command -v security >/dev/null 2>&1; then
        caddie cli:red "Error: security command not available"
        return 1
    fi

    account="$(caddie_ledger_schema_keychain_account)"
    service="$(caddie_ledger_schema_keychain_service)"

    if security add-generic-password -a "$account" -s "$service" -w "$password" -U >/dev/null 2>&1; then
        caddie cli:check "Ledger schema DB password stored in keychain"
        caddie cli:indent "service: $service"
        caddie cli:indent "account: $account"
        return 0
    fi

    caddie cli:red "Error: Failed to store keychain password"
    return 1
}

function caddie_ledger_schema_db_password_get() {
    local account=""
    local service=""

    if ! command -v security >/dev/null 2>&1; then
        caddie cli:red "Error: security command not available"
        return 1
    fi

    account="$(caddie_ledger_schema_keychain_account)"
    service="$(caddie_ledger_schema_keychain_service)"

    if caddie_ledger_schema_db_password_read >/dev/null 2>&1; then
        caddie cli:green "Ledger schema DB password: <set>"
        caddie cli:indent "service: $service"
        caddie cli:indent "account: $account"
        return 0
    fi

    caddie cli:yellow "Ledger schema DB password: <not set>"
    caddie cli:thought "Use 'caddie ledger:schema:db:password:set [password]'"
    return 0
}

function caddie_ledger_schema_db_password_unset() {
    local account=""
    local service=""

    if ! command -v security >/dev/null 2>&1; then
        caddie cli:red "Error: security command not available"
        return 1
    fi

    account="$(caddie_ledger_schema_keychain_account)"
