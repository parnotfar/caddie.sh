function caddie_cli_info() {
    local colors="unknown"

    caddie cli:title "CLI Info"
    if command -v tput >/dev/null 2>&1; then
        colors="$(tput colors 2>/dev/null || printf 'unknown')"
    fi
    caddie cli:indent "colors: ${colors}"
    caddie cli:indent "utf-8 icons: enabled"
    return 0
}
